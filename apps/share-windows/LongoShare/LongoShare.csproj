<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LongoShare</AssemblyName>
    <RootNamespace>LongoShare.App</RootNamespace>
    <Version>0.1.1</Version>
    <Product>Longo Share</Product>
    <Company>Long Ngô</Company>
    <ApplicationIcon>..\..\..\packages\ui-windows\Icons\share.ico</ApplicationIcon>
    <ApplicationManifest>..\..\..\packages\ui-windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Import Project="..\..\..\packages\ui-windows\App.props" />

  <ItemGroup>
    <ProjectReference Include="..\LongoShareKit\LongoShareKit.csproj" />
  </ItemGroup>

</Project>
