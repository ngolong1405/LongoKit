<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LongoShare.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LongoShareCore\LongoShareCore.csproj" />
    <ProjectReference Include="..\..\..\packages\ui-windows\LongoKitUI\LongoKitUI.csproj" />
    <InternalsVisibleTo Include="LongoKit.Windows.Tests" />
    <!-- WPF projects leave System.IO out (its Path would clash with WPF's shape); here Path means the file one. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
