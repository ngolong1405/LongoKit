<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LongoDisplay</AssemblyName>
    <RootNamespace>LongoDisplay.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Longo Display</Product>
    <Company>Long Ngô</Company>
    <ApplicationIcon>..\..\..\packages\ui-windows\Icons\display.ico</ApplicationIcon>
    <ApplicationManifest>..\..\..\packages\ui-windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LongoDisplayKit\LongoDisplayKit.csproj" />
  </ItemGroup>

</Project>
