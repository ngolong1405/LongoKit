<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LongoKit</AssemblyName>
    <RootNamespace>LongoKit.App</RootNamespace>
    <Version>0.1.2</Version>
    <Product>LongoKit</Product>
    <Company>Long Ngô</Company>
    <ApplicationIcon>..\..\..\packages\ui-windows\Icons\kit.ico</ApplicationIcon>
    <ApplicationManifest>..\..\..\packages\ui-windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Import Project="..\..\..\packages\ui-windows\App.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\mouse-windows\LongoMouseKit\LongoMouseKit.csproj" />
    <ProjectReference Include="..\..\shot-windows\LongoShotKit\LongoShotKit.csproj" />
    <ProjectReference Include="..\..\display-windows\LongoDisplayKit\LongoDisplayKit.csproj" />
    <ProjectReference Include="..\..\share-windows\LongoShareKit\LongoShareKit.csproj" />
  </ItemGroup>

</Project>
