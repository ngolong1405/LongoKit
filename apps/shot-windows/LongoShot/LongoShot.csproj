<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LongoShot</AssemblyName>
    <RootNamespace>LongoShot.App</RootNamespace>
    <Version>0.1.3</Version>
    <Product>Longo Shot</Product>
    <Company>Long Ngô</Company>
    <ApplicationIcon>..\..\..\packages\ui-windows\Icons\shot.ico</ApplicationIcon>
    <ApplicationManifest>..\..\..\packages\ui-windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Import Project="..\..\..\packages\ui-windows\App.props" />

  <ItemGroup>
    <ProjectReference Include="..\LongoShotKit\LongoShotKit.csproj" />
  </ItemGroup>

</Project>
