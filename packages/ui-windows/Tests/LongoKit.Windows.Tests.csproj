<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>LongoKit.Windows.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- WPF projects leave System.IO out (its Path would clash with WPF's shape); nothing here draws shapes. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LongoKitUI\LongoKitUI.csproj" />
    <ProjectReference Include="..\..\..\apps\display-windows\LongoDisplayKit\LongoDisplayKit.csproj" />
    <ProjectReference Include="..\..\..\apps\mouse-windows\LongoMouseKit\LongoMouseKit.csproj" />
    <ProjectReference Include="..\..\..\apps\shot-windows\LongoShotKit\LongoShotKit.csproj" />
    <ProjectReference Include="..\..\..\apps\share-windows\LongoShareKit\LongoShareKit.csproj" />
  </ItemGroup>

</Project>
