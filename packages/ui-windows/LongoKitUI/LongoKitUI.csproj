<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- For the notification area icon only (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LongoKit.UI</RootNamespace>
    <AssemblyName>LongoKitUI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms both name an Application, a Button...: WPF's are the ones meant. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="..\Icons\*.ico" Link="Icons\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
