---
// A dark-mode app window, the same on both sides of the comparison: a sidebar, a night photo, text, and a
// patch of pure black, where the difference between backlight and picture dimming shows most.
interface Props {
  black: string;
}
const { black } = Astro.props;
---

<div class="absolute inset-0 flex bg-[#0b0c10] p-5">
  <div class="flex w-full overflow-hidden rounded-xl border border-white/10 bg-[#111318]">
    <div class="hidden w-40 shrink-0 flex-col gap-2 border-r border-white/5 bg-[#0d0f13] p-3 md:flex">
      <div class="mb-1 flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span></div>
      {[70, 55, 80, 45, 60].map((w, i) => (
        <div class:list={["flex items-center gap-2 rounded-md px-2 py-1.5", i === 1 && "bg-white/10"]}>
          <span class:list={["h-3 w-3 rounded", i % 2 ? "bg-[#a78bfa]" : "bg-[#ff8a50]"]}></span>
          <span class="h-1.5 rounded-full bg-white/40" style={`width: ${w}%`}></span>
        </div>
      ))}
    </div>
    <div class="flex flex-1 flex-col gap-3 p-4">
      <div class="h-3 w-1/3 rounded-full bg-white/70"></div>
      <div class="relative h-28 overflow-hidden rounded-lg md:h-36">
        <div class="absolute inset-0 bg-gradient-to-b from-[#1d1747] via-[#7a2a55] to-[#ff7a3d]"></div>
        <div class="absolute bottom-[-30%] left-[58%] h-24 w-24 rounded-full bg-[#ffd36b] shadow-[0_0_40px_#ffb347]"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[#0b0c10]"></div>
        {[[12, 18], [30, 10], [44, 24], [70, 14], [86, 30], [20, 34]].map(([x, y]) => <span class="absolute h-1 w-1 rounded-full bg-white/90" style={`left:${x}%;top:${y}%`}></span>)}
      </div>
      <div class="flex flex-col gap-1.5">
        {[92, 78, 85, 60].map((w) => <span class="h-1.5 rounded-full bg-white/45" style={`width: ${w}%`}></span>)}
      </div>
      <div class="mt-auto flex items-center gap-3">
        <div class="h-12 w-20 rounded-md border border-white/10 bg-black"></div>
        <span class="font-code text-[10px] text-white/50">{black}</span>
      </div>
    </div>
  </div>
</div>
