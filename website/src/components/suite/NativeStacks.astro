---
import { pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    title: "Native on Every Platform",
    lead: "No Electron, no web views — real native apps that stay light.",
    status: "Status", worksOn: "Works on", builtWith: "Built with",
    available: "Available · beta", soon: "Coming soon", planned: "Planned",
    mac: "Apple Silicon & Intel · macOS 13+", win: "Windows 10 & 11",
  },
  vi: {
    title: "Native Trên Mọi Nền Tảng",
    lead: "Không Electron, không web view — app native thật sự, luôn nhẹ.",
    status: "Trạng thái", worksOn: "Chạy trên", builtWith: "Viết bằng",
    available: "Đã có · beta", soon: "Sắp có", planned: "Đang lên kế hoạch",
    mac: "Apple Silicon & Intel · macOS 13+", win: "Windows 10 & 11",
  },
});

const stacks = [
  {
    icon: "laptop_mac", tint: "text-tertiary", title: "macOS", badge: "ARM64 & x86-64",
    rows: [[t.worksOn, t.mac], [t.builtWith, "Swift + SwiftUI"], [t.status, t.available]],
    highlight: "text-primary-container",
  },
  {
    icon: "window", tint: "text-secondary", title: "Windows", badge: t.planned,
    rows: [[t.worksOn, t.win], [t.builtWith, "WinUI 3"], [t.status, t.soon]],
    highlight: "text-secondary",
  },
];
---

<section class="mx-auto w-full max-w-[1440px] px-margin-mobile py-16 md:px-margin-desktop">
  <div class="flex flex-col gap-10 rounded-3xl bg-surface-container-lowest p-8 shadow-xl md:p-12">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <span class="font-code text-label-badge tracking-widest text-primary uppercase">Architectural Symmetry</span>
        <h2 class="mt-1 text-headline-xl">{t.title}</h2>
      </div>
      <p class="max-w-md text-body-md text-on-surface-variant">{t.lead}</p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {
        stacks.map((s) => (
          <div class="flex flex-col gap-5 rounded-2xl bg-surface-container-high/60 p-6 backdrop-blur-xl md:p-8">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class:list={["material-symbols-outlined text-2xl", s.tint]}>{s.icon}</span>
                <h3 class="text-lg font-semibold">{s.title}</h3>
              </div>
              <span class:list={["rounded bg-surface-container-lowest px-2.5 py-1 font-code text-xs", s.tint]}>{s.badge}</span>
            </div>
            <div class="flex flex-col gap-3 font-code text-xs">
              {s.rows.map(([label, value], i) => (
                <div class="flex items-center justify-between gap-4 rounded-lg bg-surface-container-lowest p-3">
                  <span class="text-on-surface-variant">{label}:</span>
                  <span class:list={["text-right font-semibold", i === s.rows.length - 1 && s.highlight]}>{value}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
