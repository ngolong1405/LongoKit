---
import ProductIcon from "../ProductIcon.astro";
import { localize, pick, type Lang } from "../../i18n";
import { keysVersion } from "../../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    title: "Six Modules, One App",
    lead: "Small, native tools instead of heavy vendor software. In LongoKit each is a module you turn on or off; each is also its own app.",
    available: "Available", soon: "Coming soon",
    mouse: {
      body: "Smooth scrolling and gestures for every button, set up per mouse.",
      points: ["Trackpad-like smooth scrolling", "Gestures for every extra button", "Separate settings for each mouse"],
    },
    display: {
      body: "Brightness and volume for every display, from the menu bar or your keyboard.",
      points: ["Brightness & volume over DDC/CI", "Sync with your MacBook", "Works with multiple displays"],
    },
    keys: {
      body: "Remap keys and build shortcut layers — no firmware needed.",
      points: ["CapsLock as Esc / Hyper", "Vim-style arrow keys", "Separate keys for each keyboard"],
    },
    shot: {
      body: "Screenshots, screen recordings and on-screen text, each from its own shortcut, saved and on your clipboard.",
      points: ["Area, window or full screen, then draw on it", "Screen recording as MP4", "Copy text in any script, on-device OCR"],
    },
    share: {
      body: "Files and text between your Macs, PCs and phones nearby, as a chat with each device. No cloud, no account.",
      points: ["A chat with each device, previews of each picture", "Works with LocalSend on phones & Linux", "Asks before anything comes in"],
    },
    flow: {
      body: "One keyboard and mouse for your Macs: push the pointer past the edge and it's on the next Mac, with the clipboard.",
      points: ["Arrange the Macs like displays", "Clicks, keys, scrolling & media keys go over", "Encrypted, on your own network"],
    },
  },
  vi: {
    title: "Sáu Module, Một App",
    lead: "Công cụ nhỏ, native, thay cho phần mềm nặng của từng hãng. Trong LongoKit mỗi công cụ là một module bật tắt được; mỗi cái cũng là một app riêng.",
    available: "Có thể tải", soon: "Sắp có",
    mouse: {
      body: "Cuộn mượt và cử chỉ cho từng nút, cài đặt riêng cho từng con chuột.",
      points: ["Cuộn mượt như trackpad", "Cử chỉ cho mọi nút phụ", "Cài đặt riêng cho từng chuột"],
    },
    display: {
      body: "Độ sáng và âm lượng cho mọi màn hình, từ thanh menu hoặc bàn phím.",
      points: ["Độ sáng & âm lượng qua DDC/CI", "Đồng bộ theo MacBook", "Hỗ trợ nhiều màn hình"],
    },
    keys: {
      body: "Đổi phím và tạo lớp phím tắt — không cần nạp firmware.",
      points: ["CapsLock thành Esc / Hyper", "Phím mũi tên kiểu Vim", "Phím riêng cho từng bàn phím"],
    },
    shot: {
      body: "Chụp màn hình, quay màn hình và copy chữ trên màn hình, mỗi việc một phím tắt, lưu sẵn và có trong clipboard.",
      points: ["Chụp vùng, cửa sổ hoặc toàn màn hình, rồi vẽ lên", "Quay màn hình thành MP4", "Copy chữ mọi ngôn ngữ, OCR ngay trên máy"],
    },
    share: {
      body: "Gửi file và văn bản giữa Mac, máy Windows và điện thoại ở gần, mỗi máy một cuộc trò chuyện. Không cloud, không tài khoản.",
      points: ["Mỗi máy một cuộc trò chuyện, có ảnh xem trước", "Dùng được với LocalSend trên điện thoại & Linux", "Hỏi trước khi nhận bất cứ gì"],
    },
    flow: {
      body: "Một bộ bàn phím và chuột cho các máy Mac: đẩy con trỏ qua mép màn hình là sang máy bên cạnh, mang theo clipboard.",
      points: ["Xếp các máy như xếp màn hình", "Click, phím, cuộn & phím media đều sang", "Mã hoá, chỉ trong mạng của bạn"],
    },
  },
});

const pillars = [
  {
    name: "LongoMouse", product: "mouse" as const, href: localize(lang, "/mouse"), status: t.available,
    tint: "text-primary", glow: "bg-primary-container/10 group-hover:bg-primary-container/20", dot: "bg-primary",
    tagline: "Frictionless Smooth Scrolling", ...t.mouse, tech: "CGEventTap + IOKit",
  },
  {
    name: "LongoDisplay", product: "display" as const, href: localize(lang, "/display"), status: t.available,
    tint: "text-tertiary", glow: "bg-tertiary/10 group-hover:bg-tertiary/20", dot: "bg-tertiary",
    tagline: "DDC/CI Hardware Brightness", ...t.display, tech: "DDC/CI + DisplayServices",
  },
  {
    name: "LongoKeys", product: "keys" as const, href: localize(lang, "/keys"), status: keysVersion ? t.available : t.soon,
    tint: "text-secondary", glow: "bg-secondary-container/20 group-hover:bg-secondary-container/30", dot: "bg-secondary",
    tagline: "Driverless Layer Remapping", ...t.keys, tech: "UserKeyMapping + CGEventTap",
  },
  {
    name: "LongoShot", product: "shot" as const, href: localize(lang, "/shot"), status: t.available,
    tint: "text-primary-container", glow: "bg-tertiary/10 group-hover:bg-tertiary/20", dot: "bg-primary-container",
    tagline: "Capture, Record & On-Device OCR", ...t.shot, tech: "ScreenCaptureKit + Vision",
  },
  {
    name: "LongoShare", product: "share" as const, href: localize(lang, "/share"), status: t.available,
    tint: "text-tertiary", glow: "bg-tertiary/10 group-hover:bg-tertiary/20", dot: "bg-tertiary",
    tagline: "LocalSend-Compatible Sharing", ...t.share, tech: "Network.framework + LocalSend v2",
  },
  {
    name: "LongoFlow", product: "flow" as const, href: localize(lang, "/flow"), status: t.available,
    tint: "text-secondary", glow: "bg-secondary-container/20 group-hover:bg-secondary-container/30", dot: "bg-secondary",
    tagline: "One Keyboard & Mouse, Every Mac", ...t.flow, tech: "CGEventTap + Bonjour + ChaCha20",
  },
];
---

<section id="pillars" class="mx-auto w-full max-w-[1440px] px-margin-mobile py-20 md:px-margin-desktop">
  <div class="mb-14 flex flex-col gap-3">
    <span class="font-code text-label-badge tracking-widest text-primary uppercase">Granular Subsystem Calibration</span>
    <h2 class="text-headline-xl">{t.title}</h2>
    <p class="max-w-2xl text-body-lg text-on-surface-variant">{t.lead}</p>
  </div>

  <div class="grid grid-cols-1 gap-gutter-lg md:grid-cols-2 xl:grid-cols-3">
    {
      pillars.map((p) => (
        <a href={p.href} class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-surface-container-low p-8 shadow-lg transition-all hover:bg-surface-container">
          <div class:list={["absolute -top-8 -right-8 h-32 w-32 rounded-full blur-2xl transition-all", p.glow]} />
          <div class="flex flex-col gap-6">
            <div class="flex items-center justify-between">
              <ProductIcon product={p.product} class="-m-1.5 h-15 w-15" />
              <span class="rounded-full bg-surface-container-high px-2.5 py-0.5 font-code text-[10px] text-on-surface-variant">{p.status}</span>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-headline-md">{p.name}</h3>
              <span class:list={["font-code text-label-code", p.tint]}>{p.tagline}</span>
              <p class="mt-2 text-body-md leading-relaxed text-on-surface-variant">{p.body}</p>
            </div>
            <ul class="flex flex-col gap-2.5 font-code text-label-code text-on-surface-variant">
              {p.points.map((point) => (
                <li class="flex items-start gap-2"><span class:list={["mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full", p.dot]} />{point}</li>
              ))}
            </ul>
          </div>
          <div class="mt-8 flex items-center justify-between pt-4">
            <span class:list={["font-code text-xs", p.tint]}>{p.tech}</span>
            <span class:list={["material-symbols-outlined transition-transform group-hover:translate-x-1", p.tint]}>arrow_forward</span>
          </div>
        </a>
      ))
    }
  </div>
</section>
