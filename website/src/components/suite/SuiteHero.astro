---
import { mouseVersion, mouseDownload, buildFromSource, keysVersion, shotVersion } from "../../data/site";
import { pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    title: "One Suite to Master All Your Hardware.",
    platforms: "macOS 13+ · Windows coming soon",
    lead: ["Smooth scrolling and custom gestures for any mouse on", "— and soon on"],
    download: "Download LongoMouse", select: "Select Individual Kit", windowsSoon: "Windows 11: coming soon",
    copy: "copy", copied: "copied!",
    running: "Running", curve: "Each wheel notch: ease-out", smooth: "Smooth scrolling",
    smoothNote: "The mouse wheel glides like a trackpad", demo: "(demo)",
    b4: "Button 4 · Hold", b5: "Button 5 · Drag", spaces: "Switch Spaces",
    on: "ON", off: "OFF", direction: "Direction", natural: "Natural", classic: "Classic",
    tryIt: "Try it: scroll in this box", tryTouch: "Use a mouse wheel or trackpad", tryClick: "Click the mouse's buttons →",
    tryItPhone: "Try it: swipe in this box", tryTouchPhone: "Swipe up and down with your finger", tapHint: "Tap the mouse's buttons and wheel",
    stepped: "stepped, like a plain mouse", glide: "glides and eases out",
    left: "Left click", right: "Right click", middle: "Middle click: open in new tab", missionControl: "Mission Control", nextSpace: "Next Space →",
    lines: ["Scroll with the wheel here.", "With smooth scrolling on, every notch glides", "and slows down at the end, like a trackpad.", "Turn it off: the page jumps a whole notch at a time.", "Flip the direction between Natural and Classic.", "Then press the side buttons on the mouse."],
    preview: "Coming soon · preview",
    displayBody: "Adjust external display brightness and volume over DDC/CI with a slider or your Mac's brightness keys, or let them follow your MacBook.",
    displayBadge: "v0.1 beta",
    external: "External display (DisplayPort)", builtin: "MacBook display",
    follow: "Follow the MacBook", followNote: "Move the MacBook slider: the external display follows",
    hyperHint: "Hold HYPER (mouse or finger), then press H J K L", tapEsc: "Tapped: Esc", typed: "Typed",
    keysTitle: "CapsLock → Hyper & Vim layer",
    keysNote: "✨ Tap CapsLock for Esc, hold it for Hyper; H J K L become arrow keys while Hyper is held.",
    shotTitle: "Screenshots & text from the screen",
    shotBody: "One shortcut captures an area, a window or the whole screen: saved as a PNG and copied, ready to paste. ⌥⇧4 copies the text in any area instead.",
    shotArea: "Capture Area", shotText: "Copy Text", shotHint: "Drag across the screen", shotHintText: "Drag over the note's text",
    shotSaved: "Saved & copied to the clipboard", shotCopied: "Text copied", shotNone: "No text there",
    shotLines: ["Meeting notes", "Ship v0.1 on Friday", "Phở at 12:30, Hàng Bè"],
    shotNote: "✨ Text is recognized on your Mac, English and Vietnamese with diacritics. Nothing leaves the Mac.",
  },
  vi: {
    title: "Một Bộ Công Cụ Làm Chủ Mọi Thiết Bị.",
    platforms: "macOS 13+ · Windows sắp có",
    lead: ["Cuộn mượt và cử chỉ tuỳ chỉnh cho mọi con chuột trên", "— sắp có trên"],
    download: "Tải LongoMouse", select: "Chọn từng tiện ích", windowsSoon: "Windows 11: sắp có",
    copy: "copy", copied: "đã copy!",
    running: "Đang chạy", curve: "Mỗi nấc bánh xe: chậm dần (ease-out)", smooth: "Cuộn mượt",
    smoothNote: "Bánh xe chuột trượt mượt như trackpad", demo: "(minh hoạ)",
    b4: "Nút 4 · Giữ", b5: "Nút 5 · Kéo", spaces: "Chuyển Spaces",
    on: "BẬT", off: "TẮT", direction: "Hướng", natural: "Tự nhiên", classic: "Cổ điển",
    tryIt: "Thử ngay: lăn chuột trong khung này", tryTouch: "Dùng bánh xe chuột hoặc trackpad", tryClick: "Bấm thử các nút trên chuột →",
    tryItPhone: "Thử ngay: vuốt trong khung này", tryTouchPhone: "Vuốt lên xuống bằng ngón tay", tapHint: "Chạm vào các nút và bánh xe trên chuột",
    stepped: "giật từng nấc, như chuột thường", glide: "trượt mượt rồi chậm dần",
    left: "Click trái", right: "Click phải", middle: "Click giữa: mở tab mới", missionControl: "Mission Control", nextSpace: "Sang Space kế →",
    lines: ["Lăn bánh xe chuột ở đây.", "Khi bật cuộn mượt, mỗi nấc trượt êm", "rồi chậm dần ở cuối, giống trackpad.", "Tắt đi: trang nhảy cả nấc một lần.", "Đổi hướng giữa Tự nhiên và Cổ điển.", "Rồi bấm thử nút hông trên con chuột."],
    preview: "Sắp có · bản xem trước",
    displayBody: "Chỉnh độ sáng và âm lượng màn hình ngoài qua DDC/CI bằng thanh trượt hoặc phím độ sáng của Mac, hoặc để chúng đi theo MacBook.",
    displayBadge: "v0.1 beta",
    external: "Màn hình ngoài (DisplayPort)", builtin: "Màn hình MacBook",
    follow: "Theo MacBook", followNote: "Kéo thanh của MacBook: màn hình ngoài đi theo",
    hyperHint: "Giữ phím HYPER (bằng chuột hoặc ngón tay), rồi bấm H J K L", tapEsc: "Nhấn nhanh: Esc", typed: "Đã gõ",
    keysTitle: "CapsLock → Hyper & lớp phím Vim",
    keysNote: "✨ Nhấn CapsLock là Esc, giữ là Hyper; H J K L thành phím mũi tên khi giữ Hyper.",
    shotTitle: "Chụp màn hình & lấy chữ trên màn hình",
    shotBody: "Một phím tắt chụp một vùng, một cửa sổ hoặc cả màn hình: lưu thành PNG và copy sẵn để dán. ⌥⇧4 thì copy chữ trong vùng bạn chọn.",
    shotArea: "Chụp vùng", shotText: "Copy chữ", shotHint: "Kéo trên màn hình", shotHintText: "Kéo qua chữ trong ghi chú",
    shotSaved: "Đã lưu & copy vào clipboard", shotCopied: "Đã copy chữ", shotNone: "Không có chữ ở đó",
    shotLines: ["Ghi chú cuộc họp", "Phát hành v0.1 thứ Sáu", "Phở lúc 12:30, Hàng Bè"],
    shotNote: "✨ Chữ được nhận dạng ngay trên máy Mac, cả tiếng Anh lẫn tiếng Việt có dấu. Không gì rời khỏi máy.",
  },
});

const keyRows = [
  ["ESC", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BKSP"],
  ["TAB", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "\\ |"],
];
const homeRow = ["A", "S", "D", "F", "G"];
const vim = ["H ←", "J ↓", "K ↑", "L →"];
---

<div class="relative w-full overflow-hidden">
  <div class="pointer-events-none absolute -top-40 left-1/2 h-[550px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-primary-container/20 via-secondary-container/25 to-tertiary/15 blur-[140px]"></div>

  <section class="relative mx-auto flex max-w-[1440px] flex-col items-center px-margin-mobile pt-10 pb-20 text-center md:px-margin-desktop">
    <div class="mb-6 inline-flex items-center gap-space-xs rounded-full bg-surface-container-high/80 px-3.5 py-1.5 shadow-sm backdrop-blur-xl">
      <span class="h-2 w-2 animate-pulse rounded-full bg-primary-container shadow-[0_0_10px_#ff6b35]"></span>
      <span class="font-code text-label-badge tracking-wider uppercase">⚡ LongoMouse v{mouseVersion} beta</span>
      <span class="text-xs text-outline">•</span>
      <span class="font-code text-label-code text-tertiary">{t.platforms}</span>
    </div>

    <h1 class="max-w-5xl font-display text-display-hero tracking-tight md:text-[5rem] md:leading-[5.5rem]">
      {t.title}
    </h1>
    <p class="mt-6 max-w-3xl text-body-xl leading-relaxed text-on-surface-variant">
      {t.lead[0]}{" "}
      <span class="bg-gradient-to-r from-primary via-primary-container to-secondary bg-clip-text font-semibold text-transparent">macOS</span>{" "}
      {t.lead[1]}{" "}
      <span class="bg-gradient-to-r from-secondary to-tertiary bg-clip-text font-semibold text-transparent">Windows 11</span>.
    </p>

    <div class="mt-10 flex w-full max-w-2xl flex-col items-center gap-4">
      <div class="flex w-full flex-col items-center justify-center gap-space-md sm:flex-row">
        <a
          href={mouseDownload}
          class="group flex w-full items-center justify-between gap-space-md rounded-xl bg-gradient-to-r from-primary-container to-secondary-container px-6 py-4 font-semibold shadow-[0_12px_32px_-6px_rgba(255,107,53,0.35)] transition-all hover:-translate-y-0.5 hover:shadow-[0_16px_40px_-4px_rgba(255,107,53,0.5)] sm:w-auto"
        >
          <span class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined text-[28px] text-white">mouse</span>
            <span class="flex flex-col text-left">
              <span class="font-display text-sm leading-tight text-white">{t.download}</span>
              <span class="font-code text-[11px] text-white/80">macOS Universal · .dmg</span>
            </span>
          </span>
          <span class="material-symbols-outlined text-[20px] text-white transition-transform group-hover:translate-y-0.5">arrow_downward</span>
        </a>
        <a
          href="#downloads"
          class="group flex w-full items-center justify-between gap-space-md rounded-xl bg-surface-container-high/80 px-6 py-4 font-medium shadow-md backdrop-blur-xl transition-all hover:-translate-y-0.5 hover:bg-surface-container-highest sm:w-auto"
        >
          <span class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined text-[24px] text-tertiary">widgets</span>
            <span class="flex flex-col text-left">
              <span class="font-display text-sm leading-tight">{t.select}</span>
              <span class="font-code text-[11px] text-on-surface-variant">Mouse · Keys · Display · Shot</span>
            </span>
          </span>
          <span class="material-symbols-outlined text-[20px] text-on-surface-variant transition-transform group-hover:translate-x-1">arrow_forward</span>
        </a>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 font-code text-xs text-on-surface-variant">
        <span class="flex items-center gap-1 text-primary"><span class="material-symbols-outlined text-xs">check_circle</span> macOS 13+ (Apple Silicon &amp; Intel)</span>
        <span class="text-outline">•</span>
        <span class="flex items-center gap-1 text-secondary"><span class="material-symbols-outlined text-xs">schedule</span> {t.windowsSoon}</span>
      </div>
    </div>

    <div class="mt-6 flex max-w-full items-center gap-2 rounded-full bg-surface-container-lowest/80 px-4 py-2 font-code text-label-code text-on-surface-variant shadow-inner">
      <span class="text-primary-container">$</span>
      <span class="truncate">git clone … &amp;&amp; ./scripts/build-app.sh</span>
      <button type="button" class="copy ml-2 rounded bg-surface-container-high px-2 py-0.5 text-[11px] text-tertiary transition-colors hover:bg-surface-bright" data-copy={buildFromSource} data-copied={t.copied}>{t.copy}</button>
    </div>

    <!-- Device center preview -->
    <div class="mt-14 w-full max-w-[1180px] overflow-hidden rounded-2xl bg-surface-container-lowest/90 text-left shadow-[0_32px_80px_-20px_var(--c-shadow)]">
      <div class="flex h-12 items-center justify-between gap-3 bg-surface-container/80 px-5 backdrop-blur-xl">
        <div class="flex items-center gap-2">
          <span class="inline-block h-3 w-3 rounded-full bg-[#ff5f56]/90"></span>
          <span class="inline-block h-3 w-3 rounded-full bg-[#ffbd2e]/90"></span>
          <span class="inline-block h-3 w-3 rounded-full bg-[#27c93f]/90"></span>
          <span class="ml-3 hidden font-code text-xs text-on-surface-variant md:inline">LongoKit Device Center</span>
        </div>
        <div class="flex items-center gap-1 rounded-full bg-surface-container-lowest p-1" role="tablist">
          <button type="button" class="hub-tab" data-tab="mouse" role="tab">
            <span class="material-symbols-outlined text-[15px]">mouse</span><span class="hidden sm:inline">LongoMouse</span>
          </button>
          <button type="button" class="hub-tab" data-tab="display" role="tab">
            <span class="material-symbols-outlined text-[15px]">desktop_windows</span><span class="hidden sm:inline">LongoDisplay</span>
          </button>
          <button type="button" class="hub-tab" data-tab="keyboard" role="tab">
            <span class="material-symbols-outlined text-[15px]">keyboard</span><span class="hidden sm:inline">LongoKeys</span>
          </button>
          <button type="button" class="hub-tab" data-tab="shot" role="tab">
            <span class="material-symbols-outlined text-[15px]">screenshot_region</span><span class="hidden sm:inline">LongoShot</span>
          </button>
        </div>
        <span class="hidden rounded-full bg-tertiary/10 px-2.5 py-0.5 font-code text-[11px] text-tertiary sm:inline">macOS 13+</span>
      </div>

      <!-- LongoMouse -->
      <div class="hub-panel grid grid-cols-1 items-center gap-8 bg-gradient-to-b from-surface-container-low/70 to-surface-container-lowest p-6 md:p-10 lg:grid-cols-12" data-panel="mouse" data-left={t.left} data-right={t.right} data-middle={t.middle} data-b4={t.missionControl} data-b5={t.nextSpace}>
        <div class="flex flex-col gap-5 lg:col-span-5">
          <div class="flex items-center justify-between">
            <div>
              <span class="font-code text-label-badge tracking-widest text-primary uppercase">Smooth Scrolling</span>
              <h3 class="text-headline-md">Ergonomic Precision</h3>
            </div>
            <span class="shrink-0 rounded-full bg-primary-container/20 px-2.5 py-1 font-code text-xs font-semibold whitespace-nowrap text-primary-container">{t.running}</span>
          </div>
          <!-- Try it: a scroll box that behaves like Longo Mouse would -->
          <div class="flex flex-col gap-2 rounded-xl bg-surface-container-high/60 p-4 backdrop-blur-md">
            <div class="flex flex-col gap-0.5 font-code text-[11px] sm:flex-row sm:items-start sm:justify-between sm:gap-3">
              <span class="text-primary"><span class="pointer-coarse:hidden">{t.tryIt}</span><span class="hidden pointer-coarse:inline">{t.tryItPhone}</span></span>
              <span id="demo-mode" class="text-on-surface-variant sm:shrink-0 sm:text-right" data-glide={t.glide} data-stepped={t.stepped}>{t.glide}</span>
            </div>
            <div id="demo-scroll" class="relative h-36 overflow-hidden rounded-lg bg-surface-container-lowest/80 text-left" tabindex="0" aria-label={t.tryIt}>
              <div id="demo-content" class="flex flex-col gap-3 p-3 will-change-transform">
                {
                  Array.from({ length: 6 }, (_, round) =>
                    t.lines.map((line, i) => (
                      <p class="flex gap-3 font-code text-[12px] text-on-surface-variant">
                        <span class="w-5 shrink-0 text-right text-outline">{round * t.lines.length + i + 1}</span>
                        <span class:list={[i === 0 && "text-on-surface"]}>{line}</span>
                      </p>
                    ))
                  )
                }
              </div>
            </div>
            <span class="font-code text-[10px] text-outline"><span class="pointer-coarse:hidden">{t.tryTouch}</span><span class="hidden pointer-coarse:inline">{t.tryTouchPhone}</span></span>
          </div>
          <div class="flex items-center justify-between rounded-xl bg-surface-container/70 p-4">
            <div class="flex flex-col">
              <span class="text-body-md font-medium">{t.smooth}</span>
              <span class="text-xs text-on-surface-variant">{t.smoothNote}</span>
            </div>
            <label class="relative inline-flex cursor-pointer items-center">
              <input id="demo-smooth" type="checkbox" checked class="peer sr-only" aria-label={t.smooth} />
              <span class="h-6 w-11 rounded-full bg-surface-container-highest transition-colors peer-checked:bg-primary-container after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full"></span>
            </label>
          </div>
          <div class="flex items-center justify-between rounded-xl bg-surface-container/70 p-4">
            <span class="text-body-md font-medium">{t.direction}</span>
            <div class="flex rounded-lg bg-surface-container-lowest p-1 font-code text-xs" role="radiogroup">
              <button type="button" class="demo-dir rounded-md px-3 py-1" data-dir="natural" aria-checked="true">{t.natural}</button>
              <button type="button" class="demo-dir rounded-md px-3 py-1" data-dir="classic" aria-checked="false">{t.classic}</button>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="demo-press flex flex-col gap-1 rounded-lg bg-surface-container-low p-3 text-left transition-colors hover:bg-surface-container" data-action="b4">
              <span class="font-code text-[11px] text-on-surface-variant">{t.b4}</span>
              <span class="text-body-sm font-semibold text-primary">Mission Control</span>
            </button>
            <button type="button" class="demo-press flex flex-col gap-1 rounded-lg bg-surface-container-low p-3 text-left transition-colors hover:bg-surface-container" data-action="b5">
              <span class="font-code text-[11px] text-on-surface-variant">{t.b5}</span>
              <span class="text-body-sm font-semibold text-secondary">{t.spaces}</span>
            </button>
          </div>
        </div>

        <div class="relative flex min-h-[380px] flex-col items-center justify-center p-2 sm:p-8 lg:col-span-7">
          <div class="pointer-events-none absolute h-72 w-72 rounded-full bg-gradient-to-tr from-primary-container/30 to-secondary-container/20 blur-[70px]"></div>
          <div class="relative flex h-80 w-56 flex-col items-center rounded-[70px] sm:h-96 sm:w-64 bg-surface-container-high/90 p-4 pt-5 shadow-[0_20px_50px_rgba(255,107,53,0.2)] backdrop-blur-2xl">
            <!-- Left and right halves, the wheel and the side buttons can all be clicked -->
            <button type="button" class="demo-press absolute top-0 left-0 h-40 w-1/2 rounded-tl-[70px] transition-colors hover:bg-white/5" data-action="left" aria-label={t.left}></button>
            <button type="button" class="demo-press absolute top-0 right-0 h-40 w-1/2 rounded-tr-[70px] transition-colors hover:bg-white/5" data-action="right" aria-label={t.right}></button>
            <button type="button" class="demo-press relative z-10 flex h-20 w-8 flex-col items-center justify-center rounded-full bg-surface-container-lowest p-1 shadow-inner" data-action="middle" aria-label={t.middle}>
              <span id="demo-wheel" class="h-12 w-3.5 rounded-full bg-gradient-to-b from-primary-container to-secondary-container shadow-[0_0_12px_#ff6b35] transition-transform"></span>
            </button>
            <div class="pointer-events-none -mt-10 flex w-full justify-between px-3 font-code text-[9px] text-on-surface-variant sm:px-6 sm:text-[10px]">
              <span>L1 PRIMARY</span><span>R1 SECONDARY</span>
            </div>
            <div class="absolute top-32 left-0 z-10 flex -translate-x-3 flex-col gap-3">
              <button type="button" class="demo-press demo-side relative flex h-10 w-3 items-center justify-center rounded-l-lg bg-primary-container after:absolute after:-inset-x-5 after:-inset-y-1 after:content-[''] shadow-[0_0_12px_#ff6b35]" data-action="b4" aria-label="Button 4 · Mission Control"><span class="h-4 w-1 rounded-full bg-white/70"></span></button>
              <button type="button" class="demo-press demo-side relative flex h-10 w-3 items-center justify-center rounded-l-lg bg-surface-bright after:absolute after:-inset-x-5 after:-inset-y-1 after:content-[''] transition-colors hover:bg-secondary" data-action="b5" aria-label={`Button 5 · ${t.spaces}`}><span class="h-4 w-1 rounded-full bg-white/40"></span></button>
            </div>
            <span class="pointer-events-none absolute top-[7.5rem] -left-40 hidden font-code text-[10px] text-primary lg:block">{t.tryClick}</span>
            <div id="demo-toast" class="pointer-events-none absolute top-1/2 left-1/2 z-20 flex -translate-x-1/2 -translate-y-1/2 scale-90 items-center gap-2 rounded-xl bg-surface-container-lowest/95 px-4 py-3 font-display text-sm whitespace-nowrap opacity-0 shadow-2xl transition-all duration-200">
              <span id="demo-toast-icon" class="material-symbols-outlined text-[20px] text-primary">mouse</span>
              <span id="demo-toast-text"></span>
            </div>
            <div class="mt-auto mb-6 flex flex-col items-center">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-lowest shadow-inner">
                <span class="h-3 w-3 rounded-full bg-tertiary shadow-[0_0_8px_var(--c-tertiary)]"></span>
              </div>
              <span class="mt-2 font-code text-[10px] tracking-widest text-on-surface-variant uppercase">LongoMouse</span>
            </div>
          </div>
          <span class="mt-4 font-code text-[11px] text-primary lg:hidden">{t.tapHint}</span>
          <div class="mt-4 flex items-center gap-3 rounded-full bg-surface-container/90 px-4 py-2.5 font-code text-[11px] whitespace-nowrap shadow-lg sm:mt-6 sm:gap-4 sm:px-5 sm:text-xs">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-tertiary"></span>{t.smooth}: <strong id="demo-smooth-state" class="text-tertiary" data-on={t.on} data-off={t.off}>{t.on}</strong></span>
            <span class="text-outline">|</span>
            <span>{t.direction}: <strong id="demo-dir-state" class="text-primary-container">{t.natural}</strong></span>
          </div>
        </div>
      </div>

      <!-- LongoDisplay -->
      <div class="hub-panel hidden grid-cols-1 items-center gap-8 bg-gradient-to-b from-surface-container-low/70 to-surface-container-lowest p-6 md:p-10 lg:grid-cols-12" data-panel="display">
        <div class="flex flex-col gap-5 lg:col-span-6">
          <div class="flex items-center gap-2">
            <span class="font-code text-label-badge tracking-widest text-tertiary uppercase">DDC/CI</span>
            <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] text-on-surface-variant">{t.displayBadge}</span>
          </div>
          <h3 class="text-headline-md">True Hardware Luminance</h3>
          <p class="text-body-sm text-on-surface-variant">{t.displayBody}</p>
          {
            [
              { id: "external", icon: "tv", tint: "text-tertiary", name: t.external, value: 78, accent: "accent-primary-container" },
              { id: "builtin", icon: "laptop_mac", tint: "text-secondary", name: t.builtin, value: 62, accent: "accent-tertiary" },
            ].map((d) => (
              <div class="flex flex-col gap-3 rounded-xl bg-surface-container-high/70 p-4">
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-2 font-display text-sm">
                    <span class:list={["material-symbols-outlined text-[20px]", d.tint]}>{d.icon}</span>
                    {d.name}
                  </span>
                  <span class="lum-value font-code text-xs font-semibold text-primary">{d.value}%</span>
                </div>
                <input type="range" min="0" max="100" value={d.value} data-display={d.id} class:list={["lum h-2 w-full cursor-pointer rounded-lg", d.accent]} aria-label={d.name} />
              </div>
            ))
          }
          <div class="flex items-center justify-between rounded-xl bg-surface-container/70 p-4">
            <div class="flex flex-col text-left">
              <span class="text-body-md font-medium">{t.follow}</span>
              <span class="text-xs text-on-surface-variant">{t.followNote}</span>
            </div>
            <label class="relative inline-flex cursor-pointer items-center">
              <input id="demo-follow" type="checkbox" class="peer sr-only" aria-label={t.follow} />
              <span class="h-6 w-11 rounded-full bg-surface-container-highest transition-colors peer-checked:bg-tertiary after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full"></span>
            </label>
          </div>
        </div>
        <div class="flex flex-col items-center justify-center p-6 lg:col-span-6">
          <div class="flex w-full max-w-md flex-col items-center gap-4 rounded-2xl bg-surface-container-high/90 p-6 shadow-2xl">
            <!-- The external display: its picture dims with the slider -->
            <div class="relative flex h-44 w-full flex-col justify-between overflow-hidden rounded-xl bg-gradient-to-br from-[#ff8a50] via-[#8b5cf6] to-[#06b6d4] p-3 shadow-inner">
              <div class="relative z-10 flex items-center justify-between font-code text-[10px] text-white/90"><span>EXTERNAL DISPLAY</span><span id="lum-external-label">78%</span></div>
              <div class="relative z-10 mx-auto flex h-16 w-28 flex-col gap-1.5 rounded-lg bg-white/25 p-2 backdrop-blur-sm">
                <span class="h-1.5 w-16 rounded-full bg-white/80"></span><span class="h-1.5 w-20 rounded-full bg-white/60"></span><span class="h-1.5 w-12 rounded-full bg-white/60"></span>
              </div>
              <div class="h-1 w-full"></div>
              <div id="lum-external" class="absolute inset-0 bg-black transition-opacity duration-150" style="opacity: 0.18"></div>
            </div>
            <div class="h-8 w-16 rounded-b-md bg-surface-container-highest"></div>
            <div class="h-2 w-32 rounded-full bg-surface-container"></div>
            <!-- The MacBook -->
            <div class="mt-2 flex flex-col items-center">
              <div class="relative h-20 w-36 overflow-hidden rounded-t-lg border-4 border-b-0 border-surface-container-highest bg-gradient-to-br from-[#ff8a50] via-[#8b5cf6] to-[#06b6d4]">
                <div id="lum-builtin" class="absolute inset-0 bg-black transition-opacity duration-150" style="opacity: 0.3"></div>
              </div>
              <div class="h-2 w-44 rounded-b-md bg-surface-container-highest"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- LongoKeys -->
      <div class="hub-panel hidden flex-col gap-6 bg-gradient-to-b from-surface-container-low/70 to-surface-container-lowest p-6 md:p-10" data-panel="keyboard">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-code text-label-badge tracking-widest text-secondary uppercase">Layer Remapping</span>
              {!keysVersion && <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] text-on-surface-variant">{t.preview}</span>}
            </div>
            <h3 class="text-headline-md">{t.keysTitle}</h3>
          </div>
          <span class="rounded bg-secondary-container/40 px-3 py-1 font-code text-xs text-secondary">Hyper = ⌥ ⌘ ⌃ ⇧</span>
        </div>
        <div class="w-full overflow-x-auto rounded-xl bg-surface-container-lowest/90 p-4 shadow-inner md:p-6">
          <!-- On phones only the Hyper row shows, wide enough to hold HYPER with one finger and tap H J K L with another. -->
          <div class="flex flex-col gap-2 font-code text-xs sm:min-w-[680px]">
            {
              keyRows.map((row) => (
                <div class="hidden gap-1.5 sm:flex">
                  {row.map((k) => (
                    <button type="button" class:list={["demo-key flex h-10 items-center justify-center rounded bg-surface-container-high select-none", k.length > 2 ? "flex-[1.5]" : "flex-1"]} data-key={k.length > 2 ? k.split(" ")[0].toLowerCase() : k.toLowerCase()}>{k}</button>
                  ))}
                </div>
              ))
            }
            <div class="flex gap-1.5">
              <button type="button" id="demo-hyper" class="flex h-14 flex-[1.6] touch-none items-center justify-center rounded bg-gradient-to-r from-primary-container to-secondary px-3 font-bold text-white shadow-[0_0_12px_#ff6b35] select-none sm:h-10 sm:flex-[1.6]">HYPER</button>
              {homeRow.map((k) => <button type="button" class="demo-key hidden h-10 flex-1 items-center justify-center rounded bg-surface-container-high select-none sm:flex" data-key={k.toLowerCase()}>{k}</button>)}
              {vim.map((k) => (
                <button type="button" class="demo-key demo-vim flex h-14 flex-1 flex-col items-center justify-center gap-0.5 rounded bg-surface-container-high font-semibold text-secondary select-none sm:h-10 sm:flex-row sm:gap-1" data-key={k[0].toLowerCase()}>
                  <span>{k.split(" ")[0]}</span><span>{k.split(" ")[1]}</span>
                </button>
              ))}
              <button type="button" class="demo-key hidden h-10 flex-[2.5] items-center justify-center rounded bg-surface-container-high select-none sm:flex" data-key="enter">ENTER</button>
            </div>
          </div>
        </div>
        <!-- What the keys just did: a cursor that H J K L move while Hyper is held -->
        <div class="flex flex-col gap-3 rounded-xl bg-surface-container-high/60 p-4 md:flex-row md:items-center">
          <div id="demo-grid" class="grid shrink-0 grid-cols-7 gap-1 self-center" aria-hidden="true">
            {Array.from({ length: 21 }, () => <span class="h-4 w-4 rounded-sm bg-surface-container-lowest"></span>)}
          </div>
          <div class="flex flex-col gap-1 text-left">
            <span class="font-code text-xs text-secondary">{t.hyperHint}</span>
            <span id="demo-keys-out" class="font-code text-sm text-on-surface" data-typed={t.typed} data-esc={t.tapEsc}>—</span>
          </div>
        </div>
        <span class="font-code text-xs text-on-surface-variant">{t.keysNote}</span>
      </div>
      <!-- LongoShot -->
      <div class="hub-panel hidden grid-cols-1 items-center gap-8 bg-gradient-to-b from-surface-container-low/70 to-surface-container-lowest p-6 md:p-10 lg:grid-cols-12" data-panel="shot">
        <div class="flex flex-col gap-5 lg:col-span-5">
          <div class="flex items-center gap-2">
            <span class="font-code text-label-badge tracking-widest text-tertiary uppercase">Capture + OCR</span>
            <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] text-on-surface-variant">v{shotVersion}</span>
          </div>
          <h3 class="text-headline-md">{t.shotTitle}</h3>
          <p class="text-body-sm text-on-surface-variant">{t.shotBody}</p>
          <div class="flex items-center justify-between rounded-xl bg-surface-container/70 p-4">
            <span class="font-code text-xs text-on-surface-variant" id="shot-hint" data-area={t.shotHint} data-text={t.shotHintText}>{t.shotHint}</span>
            <div class="flex shrink-0 rounded-lg bg-surface-container-lowest p-1 font-code text-xs" role="radiogroup">
              <button type="button" class="shot-mode rounded-md px-3 py-1" data-mode="area" aria-checked="true">⌥⇧1</button>
              <button type="button" class="shot-mode rounded-md px-3 py-1" data-mode="text" aria-checked="false">⌥⇧4</button>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 font-code text-[11px]">
            <span class="flex items-center gap-2 rounded-lg bg-surface-container-low p-3"><span class="material-symbols-outlined text-[18px] text-primary">screenshot_region</span>{t.shotArea}</span>
            <span class="flex items-center gap-2 rounded-lg bg-surface-container-low p-3"><span class="material-symbols-outlined text-[18px] text-tertiary">document_scanner</span>{t.shotText}</span>
          </div>
          <span class="font-code text-xs text-on-surface-variant">{t.shotNote}</span>
        </div>
        <div class="flex min-w-0 flex-col items-center justify-center lg:col-span-7">
          <!-- A small screen: drag on it to capture, or to copy the note's text. -->
          <div id="shot-screen" class="relative aspect-[16/10] w-full max-w-xl touch-none overflow-hidden rounded-xl bg-gradient-to-br from-[#ff8a50] via-[#8b5cf6] to-[#06b6d4] shadow-2xl select-none">
            <div class="absolute top-[14%] left-[7%] flex w-[56%] flex-col gap-1.5 rounded-lg bg-white/90 p-3 shadow-[0_10px_30px_rgba(0,0,0,0.35)] dark:bg-[#1c2028]/90">
              {t.shotLines.map((line, i) => <span class:list={["shot-line truncate font-code text-[10px] sm:text-xs", i === 0 ? "font-bold text-[#141b2b] dark:text-white" : "text-[#5a4139] dark:text-[#e1bfb5]"]}>{line}</span>)}
            </div>
            <div class="absolute right-[7%] bottom-[12%] flex h-[38%] w-[26%] items-end gap-[8%] rounded-lg bg-white/90 p-[3%] shadow-[0_10px_30px_rgba(0,0,0,0.35)] dark:bg-[#1c2028]/90">
              {[40, 70, 55, 90].map((h) => <span class="flex-1 rounded-sm bg-gradient-to-t from-[#06b6d4] to-[#8b5cf6]" style={`height: ${h}%`}></span>)}
            </div>
            <div id="shot-sel" class="pointer-events-none absolute hidden rounded-[3px] border-[1.5px] border-white shadow-[0_0_0_9999px_rgba(0,0,0,0.35)]"></div>
            <div id="shot-toast" class="pointer-events-none absolute inset-x-3 bottom-3 z-20 mx-auto flex w-fit scale-90 items-center gap-2 rounded-xl bg-surface-container-lowest/95 px-3 py-2 font-display text-xs opacity-0 shadow-2xl transition-all duration-200 sm:text-sm" data-saved={t.shotSaved} data-copied={t.shotCopied} data-none={t.shotNone}>
              <span id="shot-toast-icon" class="material-symbols-outlined text-[18px] text-primary">check_circle</span>
              <span id="shot-toast-text" class="line-clamp-2"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .hub-tab {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    padding: 0.25rem 0.875rem;
    font-family: var(--font-code);
    font-size: var(--text-label-code);
    color: var(--c-on-surface-variant);
    transition: all 0.2s;
  }
  .hub-tab:hover { color: var(--c-on-surface); }
  .hub-tab[aria-selected="true"] {
    background: var(--c-primary-container);
    color: var(--c-on-primary-container);
    font-weight: 600;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }
  .lum { appearance: none; background: var(--c-surface-container-lowest); }
  .demo-dir, .shot-mode { color: var(--c-on-surface-variant); }
  .demo-dir[aria-checked="true"], .shot-mode[aria-checked="true"] { background: var(--c-surface-container-high); color: var(--c-on-surface); font-weight: 600; }
  .demo-side.pressed, .demo-press.pressed { filter: brightness(1.4); }
  #demo-hyper.held { transform: translateY(2px) scale(0.94); box-shadow: 0 0 28px #ff6b35, inset 0 2px 4px rgb(0 0 0 / 0.3); }
  [data-panel="keyboard"].hyper .demo-vim { background: var(--c-secondary-container); color: white; }
  /* A key going down: pressed in, lit, then springing back. */
  .demo-key, #demo-hyper { transition: transform 0.08s, box-shadow 0.12s, background-color 0.12s, color 0.12s; touch-action: manipulation; }
  .demo-key:hover { background: var(--c-surface-container-highest); }
  [data-panel="keyboard"] .demo-key.hit, [data-panel="keyboard"] .demo-key:active {
    transform: translateY(2px) scale(0.92);
    background: var(--c-secondary);
    color: white;
    box-shadow: 0 0 14px var(--c-secondary), inset 0 2px 4px rgb(0 0 0 / 0.25);
  }
  #shot-screen { cursor: crosshair; }
  #demo-grid .cursor { background: var(--c-secondary); box-shadow: 0 0 8px var(--c-secondary); }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".hub-tab");
  const panels = document.querySelectorAll<HTMLElement>(".hub-panel");
  function show(tab: string) {
    tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === tab)));
    panels.forEach((p) => {
      const on = p.dataset.panel === tab;
      p.classList.toggle("hidden", !on);
      p.classList.toggle(p.dataset.panel === "keyboard" ? "flex" : "grid", on);
    });
  }
  tabs.forEach((t) => t.addEventListener("click", () => show(t.dataset.tab!)));
  show("mouse");

  // Mouse demo: the box scrolls the way Longo Mouse would, and the buttons show what they're mapped to.
  const box = document.getElementById("demo-scroll");
  const content = document.getElementById("demo-content");
  const smooth = document.getElementById("demo-smooth") as HTMLInputElement | null;
  const mode = document.getElementById("demo-mode");
  const smoothState = document.getElementById("demo-smooth-state");
  const dirState = document.getElementById("demo-dir-state");
  const wheel = document.getElementById("demo-wheel");
  let position = 0, target = 0, frame = 0, natural = true;
  const limit = () => Math.max(0, (content?.scrollHeight ?? 0) - (box?.clientHeight ?? 0));
  const render = () => { if (content) content.style.transform = `translateY(${-position}px)`; };
  const glide = () => {
    position += (target - position) * 0.12; // the same ease-out as the app: each frame covers part of what's left
    if (Math.abs(target - position) < 0.5) { position = target; frame = 0; } else frame = requestAnimationFrame(glide);
    render();
  };
  box?.addEventListener("wheel", (event) => {
    event.preventDefault();
    const sign = natural ? 1 : -1;
    if (smooth?.checked) {
      target = Math.min(limit(), Math.max(0, target + event.deltaY * sign));
      if (!frame) frame = requestAnimationFrame(glide);
    } else {
      // A plain mouse: a whole notch at once, no motion in between.
      cancelAnimationFrame(frame); frame = 0;
      position = target = Math.min(limit(), Math.max(0, position + Math.sign(event.deltaY) * sign * 60));
      render();
    }
    if (wheel) { wheel.style.transform = `translateY(${Math.sign(event.deltaY) * 3}px)`; setTimeout(() => (wheel.style.transform = ""), 120); }
  }, { passive: false });
  // Touch screens: a swipe follows the same settings. Smooth: the content follows the finger and keeps
  // gliding after it lifts, easing out. Off: it moves a notch at a time. Classic flips the direction.
  let touchY = 0, lastMove = 0, velocity = 0, carried = 0;
  box?.addEventListener("touchstart", (e) => {
    touchY = e.touches[0].clientY; lastMove = performance.now(); velocity = 0; carried = 0;
    cancelAnimationFrame(frame); frame = 0; target = position;
  }, { passive: true });
  box?.addEventListener("touchmove", (e) => {
    e.preventDefault();
    const y = e.touches[0].clientY, now = performance.now();
    const delta = (touchY - y) * (natural ? 1 : -1);
    touchY = y;
    if (smooth?.checked) {
      velocity = delta / Math.max(1, now - lastMove);
      position = target = Math.min(limit(), Math.max(0, position + delta));
      render();
    } else {
      carried += delta;
      while (Math.abs(carried) >= 40) {
        const step = Math.sign(carried);
        carried -= step * 40;
        position = target = Math.min(limit(), Math.max(0, position + step * 60));
      }
      render();
    }
    lastMove = now;
  }, { passive: false });
  box?.addEventListener("touchend", () => {
    if (!smooth?.checked || Math.abs(velocity) < 0.05) return;
    target = Math.min(limit(), Math.max(0, position + velocity * 220));
    if (!frame) frame = requestAnimationFrame(glide);
  });
  smooth?.addEventListener("change", () => {
    if (mode) mode.textContent = smooth.checked ? mode.dataset.glide ?? "" : mode.dataset.stepped ?? "";
    if (smoothState) smoothState.textContent = smooth.checked ? smoothState.dataset.on ?? "" : smoothState.dataset.off ?? "";
  });
  document.querySelectorAll<HTMLButtonElement>(".demo-dir").forEach((button) => {
    button.addEventListener("click", () => {
      natural = button.dataset.dir === "natural";
      document.querySelectorAll(".demo-dir").forEach((b) => b.setAttribute("aria-checked", String(b === button)));
      if (dirState) dirState.textContent = button.textContent;
    });
  });
  const panel = document.querySelector<HTMLElement>('[data-panel="mouse"]');
  const toast = document.getElementById("demo-toast");
  const toastText = document.getElementById("demo-toast-text");
  const toastIcon = document.getElementById("demo-toast-icon");
  const icons: Record<string, string> = { left: "left_click", right: "right_click", middle: "tab", b4: "grid_view", b5: "view_carousel" };
  let toastTimer = 0;
  document.querySelectorAll<HTMLButtonElement>(".demo-press").forEach((button) => {
    button.addEventListener("click", () => {
      const action = button.dataset.action ?? "";
      if (!toast || !toastText || !toastIcon) return;
      toastText.textContent = panel?.dataset[action] ?? "";
      toastIcon.textContent = icons[action] ?? "mouse";
      toast.classList.remove("opacity-0", "scale-90");
      document.querySelectorAll(`.demo-side[data-action="${action}"]`).forEach((side) => side.classList.add("pressed"));
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.add("opacity-0", "scale-90");
        document.querySelectorAll(".demo-side.pressed").forEach((side) => side.classList.remove("pressed"));
      }, 1300);
    });
  });

  // Display demo: the pictures dim with their sliders, and the external one can follow the MacBook.
  const follow = document.getElementById("demo-follow") as HTMLInputElement | null;
  const sliders = Object.fromEntries(
    [...document.querySelectorAll<HTMLInputElement>("input.lum")].map((input) => [input.dataset.display ?? "", input]),
  );
  function showLevel(id: string) {
    const input = sliders[id];
    if (!input) return;
    const label = input.parentElement?.querySelector(".lum-value");
    if (label) label.textContent = `${input.value}%`;
    const overlay = document.getElementById(`lum-${id}`);
    if (overlay) overlay.style.opacity = String(0.8 * (1 - Number(input.value) / 100));
    const screenLabel = document.getElementById(`lum-${id}-label`);
    if (screenLabel) screenLabel.textContent = `${input.value}%`;
  }
  Object.entries(sliders).forEach(([id, input]) => {
    input.addEventListener("input", () => {
      showLevel(id);
      if (id === "builtin" && follow?.checked && sliders.external) {
        sliders.external.value = input.value;
        showLevel("external");
      }
    });
    showLevel(id);
  });
  follow?.addEventListener("change", () => {
    if (follow.checked && sliders.external && sliders.builtin) {
      sliders.external.value = sliders.builtin.value;
      showLevel("external");
    }
  });

  // Keys demo: hold HYPER, then H J K L move the cursor; a quick tap is Esc; without Hyper they just type.
  const keysPanel = document.querySelector<HTMLElement>('[data-panel="keyboard"]');
  const hyperKey = document.getElementById("demo-hyper");
  const out = document.getElementById("demo-keys-out");
  const cells = [...document.querySelectorAll<HTMLElement>("#demo-grid span")];
  let cursor = 10, hyper = false, hyperSince = 0, usedHyper = false, typed = "";
  const drawCursor = () => cells.forEach((cell, i) => cell.classList.toggle("cursor", i === cursor));
  drawCursor();
  const moves: Record<string, [number, string]> = { h: [-1, "←"], j: [7, "↓"], k: [-7, "↑"], l: [1, "→"] };
  const names: Record<string, string> = { esc: "⎋", bksp: "⌫", tab: "⇥", enter: "↩", "\\": "\\" };
  function flash(key: string) {
    document.querySelectorAll<HTMLElement>(`.demo-key[data-key="${CSS.escape(key)}"]`).forEach((b) => {
      b.classList.add("hit");
      setTimeout(() => b.classList.remove("hit"), 160);
    });
  }
  function press(key: string) {
    if (!out) return;
    flash(key);
    if (hyper && moves[key]) {
      usedHyper = true;
      const [step, arrow] = moves[key];
      const next = cursor + step;
      const sameRow = Math.floor(next / 7) === Math.floor(cursor / 7);
      if (next >= 0 && next < cells.length && (Math.abs(step) === 7 || sameRow)) cursor = next;
      drawCursor();
      out.textContent = `Hyper + ${key.toUpperCase()} → ${arrow}`;
      return;
    }
    if (hyper) usedHyper = true;
    if (key === "bksp") typed = typed.slice(0, -1);
    else typed = (typed + (names[key] ?? key)).slice(-24);
    out.textContent = `${out.dataset.typed}: ${typed}`;
  }
  // Hyper follows the pointer that pressed it, so a second finger can tap H J K L meanwhile.
  let hyperPointer: number | null = null;
  function setHyper(on: boolean) {
    if (on === hyper) return;
    hyper = on;
    hyperKey?.classList.toggle("held", on);
    keysPanel?.classList.toggle("hyper", on);
    if (on) { hyperSince = Date.now(); usedHyper = false; }
    else if (!usedHyper && Date.now() - hyperSince < 250 && out) { flash("esc"); out.textContent = out.dataset.esc ?? "Esc"; }
  }
  hyperKey?.addEventListener("pointerdown", (e) => { e.preventDefault(); hyperPointer = e.pointerId; setHyper(true); });
  const releaseHyper = (e: PointerEvent) => { if (e.pointerId === hyperPointer) { hyperPointer = null; setHyper(false); } };
  window.addEventListener("pointerup", releaseHyper);
  window.addEventListener("pointercancel", releaseHyper);
  // Keys react on press, not release, like a real keyboard.
  document.querySelectorAll<HTMLButtonElement>(".demo-key").forEach((b) => b.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    press(b.dataset.key ?? "");
  }));
  // Real keys too, while the Keys panel is open and on screen.
  window.addEventListener("keydown", (e) => {
    if (!keysPanel || keysPanel.classList.contains("hidden") || e.metaKey || e.ctrlKey || e.altKey) return;
    const r = keysPanel.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return;
    const map: Record<string, string> = { escape: "esc", backspace: "bksp", tab: "tab", enter: "enter", "|": "\\" };
    const key = map[e.key.toLowerCase()] ?? e.key.toLowerCase();
    if (!document.querySelector(`.demo-key[data-key="${CSS.escape(key)}"]`)) return;
    e.preventDefault();
    press(key);
  });
  // Shot demo: drag on the little screen; Capture Area "saves and copies", Copy Text "reads" the lines it crosses.
  const shotScreen = document.getElementById("shot-screen");
  const shotSel = document.getElementById("shot-sel");
  const shotToast = document.getElementById("shot-toast");
  const shotHint = document.getElementById("shot-hint");
  let shotMode = "area", shotStart: { x: number; y: number } | null = null, shotTimer = 0;
  document.querySelectorAll<HTMLButtonElement>(".shot-mode").forEach((button) => {
    button.addEventListener("click", () => {
      shotMode = button.dataset.mode ?? "area";
      document.querySelectorAll(".shot-mode").forEach((b) => b.setAttribute("aria-checked", String(b === button)));
      if (shotHint) shotHint.textContent = shotHint.dataset[shotMode] ?? "";
    });
  });
  const shotPoint = (e: PointerEvent) => {
    const r = shotScreen!.getBoundingClientRect();
    return { x: Math.min(r.width, Math.max(0, e.clientX - r.left)), y: Math.min(r.height, Math.max(0, e.clientY - r.top)) };
  };
  const drawSel = (a: { x: number; y: number }, b: { x: number; y: number }) => {
    if (!shotSel) return;
    shotSel.classList.remove("hidden");
    Object.assign(shotSel.style, { left: `${Math.min(a.x, b.x)}px`, top: `${Math.min(a.y, b.y)}px`, width: `${Math.abs(b.x - a.x)}px`, height: `${Math.abs(b.y - a.y)}px` });
  };
  function shotSay(icon: string, text: string) {
    if (!shotToast) return;
    document.getElementById("shot-toast-icon")!.textContent = icon;
    document.getElementById("shot-toast-text")!.textContent = text;
    shotToast.classList.remove("opacity-0", "scale-90");
    clearTimeout(shotTimer);
    shotTimer = window.setTimeout(() => shotToast.classList.add("opacity-0", "scale-90"), 2200);
  }
  shotScreen?.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    shotStart = shotPoint(e);
    shotScreen.setPointerCapture(e.pointerId);
    drawSel(shotStart, shotStart);
  });
  shotScreen?.addEventListener("pointermove", (e) => { if (shotStart) drawSel(shotStart, shotPoint(e)); });
  shotScreen?.addEventListener("pointerup", (e) => {
    if (!shotStart || !shotScreen || !shotToast) return;
    const end = shotPoint(e), start = shotStart;
    shotStart = null;
    shotSel?.classList.add("hidden");
    if (Math.abs(end.x - start.x) < 6 || Math.abs(end.y - start.y) < 6) return;
    if (shotMode === "area") { shotSay("check_circle", shotToast.dataset.saved ?? ""); return; }
    const r = shotScreen.getBoundingClientRect();
    const top = Math.min(start.y, end.y) + r.top, bottom = Math.max(start.y, end.y) + r.top;
    const left = Math.min(start.x, end.x) + r.left, right = Math.max(start.x, end.x) + r.left;
    const lines = [...shotScreen.querySelectorAll<HTMLElement>(".shot-line")].filter((line) => {
      const b = line.getBoundingClientRect(), mid = (b.top + b.bottom) / 2;
      return mid >= top && mid <= bottom && b.left < right && b.right > left;
    });
    if (lines.length) shotSay("content_paste", `${shotToast.dataset.copied}: ${lines.map((l) => l.textContent).join(" · ")}`);
    else shotSay("search_off", shotToast.dataset.none ?? "");
  });
  shotScreen?.addEventListener("pointercancel", () => { shotStart = null; shotSel?.classList.add("hidden"); });

  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
    button.addEventListener("click", () => {
      navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = button.dataset.copied ?? "copied!";
    });
  });
</script>
