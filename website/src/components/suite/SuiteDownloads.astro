---
import ProductIcon from "../ProductIcon.astro";
import { mouseWindows, displayWindows, shotWindows, shareWindows, shareDownload, shareVersion, flowDownload, flowVersion } from "../../data/site";
import { repo, mouseDownload, mouseVersion, displayDownload, displayVersion, licenseURL, keysVersion, keysDownload, shotDownload, shotVersion, kitDownload, kitVersion } from "../../data/site";
import { localize, pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    title: "Download LongoKit.",
    lead: "All six tools in one app. Rather have just one? Each is also a small app of its own.",
    single: "Or Just One, as Its Own App",
    soon: "Coming soon", notPlanned: "Not planned",
    mouse: "Smooth scrolling and gestures for any mouse.",
    keys: "Remap keys and build shortcut layers.",
    display: "Brightness and volume for every display, with Sync to your MacBook.",
    shot: "Screenshots, screen recordings and on-screen text from your shortcuts.",
    share: "Files and text between your Macs, PCs and phones nearby. Works with LocalSend.",
    flow: "One keyboard and mouse for your Macs, the clipboard along with it.",
    suiteTitle: "LongoKit: All Six in One App",
    suiteBody: "LongoKit runs all six as modules of one menu bar app: one window, one menu bar icon, and about a quarter of the memory. Turn on just the ones you need.",
    getKit: "Download LongoKit for macOS", aboutKit: "What's in LongoKit", follow: "Follow on GitHub",
    noTelemetry: "No telemetry", notarize: "Opened from the disk image, it offers to move itself to Applications, then to delete the installer. Beta isn't notarized yet: if blocked, System Settings › Privacy & Security › Open Anyway",
  },
  vi: {
    title: "Tải LongoKit.",
    lead: "Cả sáu công cụ trong một app. Chỉ cần một? Mỗi công cụ cũng là một app nhỏ riêng.",
    single: "Hoặc Chỉ Một, Thành App Riêng",
    soon: "Sắp có", notPlanned: "Chưa có kế hoạch",
    mouse: "Cuộn mượt và cử chỉ cho mọi con chuột.",
    keys: "Đổi phím và tạo lớp phím tắt.",
    display: "Độ sáng và âm lượng cho mọi màn hình, đồng bộ theo MacBook.",
    shot: "Chụp màn hình, quay màn hình và copy chữ trên màn hình bằng phím tắt.",
    share: "Gửi file và văn bản giữa Mac, máy Windows và điện thoại ở gần. Dùng được với LocalSend.",
    flow: "Một bộ bàn phím và chuột cho các máy Mac, mang theo cả clipboard.",
    suiteTitle: "LongoKit: Cả Sáu Trong Một App",
    suiteBody: "LongoKit chạy cả sáu như các module của một app trên thanh menu: một cửa sổ, một icon trên thanh menu, và chỉ tốn khoảng một phần tư RAM. Chỉ bật module bạn cần.",
    getKit: "Tải LongoKit cho macOS", aboutKit: "LongoKit có gì", follow: "Theo dõi trên GitHub",
    noTelemetry: "Không telemetry", notarize: "Mở ngay trong file cài đặt, app tự đề nghị chuyển vào Applications rồi xoá file cài đặt. Bản beta chưa notarize: nếu bị chặn, Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Vẫn mở",
  },
});

const kits = [
  {
    name: "LongoMouse", product: "mouse" as const, version: `v${mouseVersion}`, available: true, download: mouseDownload, windows: mouseWindows.x64,
    tint: "text-primary", badgeBg: "bg-primary-container/15",
    mac: "bg-primary-container/20 text-primary hover:bg-primary-container hover:text-on-primary-container",
    tagline: "Smooth Scrolling & Gesture Engine", body: t.mouse,
  },
  {
    name: "LongoKeys", product: "keys" as const, version: keysVersion ? `v${keysVersion}` : t.soon, windows: null as string | null,
    available: !!keysDownload, download: keysDownload ?? "",
    tint: "text-secondary", badgeBg: "bg-secondary-container/25",
    mac: "bg-secondary-container/25 text-secondary hover:bg-secondary-container/40", tagline: "Layer & Hyperkey Engine", body: t.keys,
  },
  {
    name: "LongoDisplay", product: "display" as const, version: `v${displayVersion}`, available: true, download: displayDownload, windows: displayWindows.x64,
    tint: "text-tertiary", badgeBg: "bg-tertiary/20",
    mac: "bg-tertiary/15 text-tertiary hover:bg-tertiary/30", tagline: "DDC/CI Hardware Luminance", body: t.display,
  },
  {
    name: "LongoShot", product: "shot" as const, version: `v${shotVersion}`, available: true, download: shotDownload, windows: shotWindows.x64,
    tint: "text-primary-container", badgeBg: "bg-primary-container/15",
    mac: "bg-primary-container/15 text-primary-container hover:bg-primary-container/30", tagline: "Capture, Record & On-Device OCR", body: t.shot,
  },
  {
    name: "LongoShare", product: "share" as const, version: `v${shareVersion}`, available: true, download: shareDownload, windows: shareWindows.x64,
    tint: "text-tertiary", badgeBg: "bg-tertiary/20",
    mac: "bg-tertiary/15 text-tertiary hover:bg-tertiary/30", tagline: "LocalSend-Compatible Sharing", body: t.share,
  },
  {
    name: "LongoFlow", product: "flow" as const, version: `v${flowVersion}`, available: true, download: flowDownload, windows: null as string | null, windowsSoon: true,
    tint: "text-secondary", badgeBg: "bg-secondary-container/25",
    mac: "bg-secondary-container/25 text-secondary hover:bg-secondary-container/40", tagline: "One Keyboard & Mouse, Every Mac", body: t.flow,
  },
];
---

<section id="downloads" class="mx-auto w-full max-w-[1440px] px-margin-mobile py-20 md:px-margin-desktop">
  <div class="mb-14 flex flex-col items-center text-center">
    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-surface-container-high/80 px-3.5 py-1.5 backdrop-blur-xl">
      <span class="h-2 w-2 animate-pulse rounded-full bg-primary-container"></span>
      <span class="font-code text-label-badge tracking-wider uppercase">Modular Kits &amp; Universal Suite</span>
    </div>
    <h2 class="max-w-3xl font-display text-headline-xl tracking-tight md:text-[3.25rem] md:leading-[3.75rem]">{t.title}</h2>
    <p class="mt-4 max-w-2xl text-body-lg text-on-surface-variant">{t.lead}</p>
  </div>

  <div class="relative flex flex-col items-center overflow-hidden rounded-3xl bg-surface-container-lowest p-8 text-center shadow-2xl md:p-12">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-primary-container/20 via-secondary-container/25 to-tertiary/15 blur-3xl"></div>
    <div class="relative z-10 flex max-w-4xl flex-col items-center">
      <ProductIcon product="kit" class="mb-6 h-20 w-20" />
      <h3 class="font-display text-headline-xl tracking-tight md:text-[2.75rem]">{t.suiteTitle}</h3>
      <p class="mt-3 max-w-xl text-body-md text-on-surface-variant">{t.suiteBody}</p>
      <div class="mt-8 flex w-full flex-col flex-wrap items-center justify-center gap-space-md sm:flex-row">
        <a href={kitDownload} class="flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-primary-container to-secondary-container px-6 py-4 font-display text-sm font-semibold text-white shadow-[0_12px_32px_rgba(255,107,53,0.4)] transition-all hover:opacity-95 sm:w-auto">
          <span class="material-symbols-outlined text-[20px]">download</span>
          {t.getKit}
          <span class="rounded bg-white/20 px-1.5 font-code text-[11px]">v{kitVersion}</span>
        </a>
        <a href={localize(lang, "/kit")} class="flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-tertiary-container to-secondary-container px-6 py-4 font-display text-sm font-semibold text-white shadow-[0_12px_32px_rgba(0,168,196,0.35)] transition-all hover:opacity-95 sm:w-auto">
          <span class="material-symbols-outlined text-[20px]">apps</span>
          {t.aboutKit}
        </a>
        <a href={repo} class="flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-surface-container-high px-6 py-4 font-display text-sm font-medium transition-all hover:bg-surface-bright sm:w-auto">
          <span class="material-symbols-outlined text-[20px] text-tertiary">notifications</span>
          {t.follow}
        </a>
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 font-code text-xs text-on-surface-variant">
        <a class="hover:text-primary" href={licenseURL}>Source-available</a>
        <span>•</span>
        <span>{t.noTelemetry}</span>
        <span>•</span>
        <span>{t.notarize}</span>
      </div>
    </div>
  </div>
  <h3 class="mt-16 mb-8 text-center font-display text-headline-md tracking-tight">{t.single}</h3>
  <div class="grid grid-cols-1 gap-gutter-lg md:grid-cols-2 xl:grid-cols-3">
    {
      kits.map((k) => (
        <div class="relative flex flex-col justify-between overflow-hidden rounded-2xl bg-surface-container-low p-8 shadow-xl transition-all hover:bg-surface-container">
          <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between">
              <ProductIcon product={k.product} class="-m-1.5 h-15 w-15" />
              <span class:list={["rounded px-2.5 py-1 font-code text-xs", k.badgeBg, k.tint]}>{k.version}</span>
            </div>
            <div>
              <h3 class="text-headline-md">{k.name}</h3>
              <p class:list={["mt-1 font-code text-xs", k.tint]}>{k.tagline}</p>
              <p class="mt-3 text-body-sm leading-relaxed text-on-surface-variant">{k.body}</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col gap-2.5 pt-4">
            {k.available ? (
              <a href={k.download} class:list={["flex w-full flex-wrap items-center justify-between gap-x-2 gap-y-0.5 rounded-xl px-4 py-3 text-xs font-semibold shadow-sm transition-colors", k.mac]}>
                <span class="flex items-center gap-2 whitespace-nowrap"><span class="material-symbols-outlined text-[18px]">desktop_mac</span>macOS Universal (.dmg)</span>
                <span class="font-code text-[11px] whitespace-nowrap opacity-80">Apple Silicon / Intel</span>
              </a>
            ) : (
              <span class="flex w-full cursor-not-allowed items-center justify-between rounded-xl bg-surface-container-high px-4 py-3 text-xs font-medium opacity-70">
                <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">desktop_mac</span>macOS</span>
                <span class="font-code text-[11px] text-on-surface-variant">{t.soon}</span>
              </span>
            )}
            {k.windows ? (
              <a href={k.windows} class="flex w-full items-center justify-between rounded-xl bg-surface-container-high px-4 py-3 text-xs font-semibold transition-colors hover:bg-surface-bright">
                <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-tertiary">window</span>Windows 10 &amp; 11 (.exe)</span>
                <span class="font-code text-[11px] text-on-surface-variant">beta</span>
              </a>
            ) : (
              <span class="flex w-full cursor-not-allowed items-center justify-between rounded-xl bg-surface-container-high px-4 py-3 text-xs font-medium opacity-70">
                <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-tertiary">window</span>Windows</span>
                <span class="font-code text-[11px] text-on-surface-variant">{"windowsSoon" in k && k.windowsSoon ? t.soon : t.notPlanned}</span>
              </span>
            )}
          </div>
        </div>
      ))
    }
  </div>

</section>
