---
import { pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    badge: "Feature 01 · Capture", title: "Four Shortcuts, Everything on Screen",
    lead: "One key combo for each way you capture, all from the left hand. Nothing to open first: Longo Shot waits in the background.",
    cards: [
      ["screenshot_region", "⌥⇧1", "Capture Area or Window", "Drag over what you want, or hover a window (it lights up with an orange edge) and click it. Double-click: the whole screen. The screen freezes the instant you press it, so open menus and popovers stay in the picture."],
      ["fullscreen", "⌥⇧2", "Capture Full Screen", "The screen under the pointer, so with two displays you get the one you're on."],
      ["document_scanner", "⌥⇧3", "Copy Text (OCR)", "Drag over text in an image, a video or a PDF, in any script: it opens next to the picture to check, edit and copy (⌘↩)."],
      ["radio_button_checked", "⌥⇧4", "Record Screen", "Drag an area and adjust it, then Start; double-click for the whole screen. Press ⌥⇧4 again to stop."],
    ],
    more: "Also: ⌥⇧0 opens Settings. Pause / Resume Recording, Draw on Last Capture, Copy Last Capture and Open Save Folder can get their own shortcuts too. Right-click the menu bar icon to turn Longo Shot off (its shortcuts let go) or quit; double-click it for Settings.",
  },
  vi: {
    badge: "Chức năng 01 · Chụp", title: "Bốn Phím Tắt, Chụp Mọi Thứ Trên Màn Hình",
    lead: "Mỗi kiểu chụp một tổ hợp phím, bấm được bằng tay trái. Không cần mở app trước: Longo Shot luôn chờ sẵn ở chế độ nền.",
    cards: [
      ["screenshot_region", "⌥⇧1", "Chụp vùng / cửa sổ", "Kéo chọn phần cần chụp, hoặc rê chuột lên một cửa sổ (sáng viền cam) rồi bấm vào. Nhấp đúp: cả màn hình. Màn hình đứng yên ngay tức khắc khi bấm, nên menu và popover đang mở vẫn có trong ảnh."],
      ["fullscreen", "⌥⇧2", "Chụp toàn màn hình", "Màn hình đang có con trỏ, nên dùng hai màn hình thì chụp đúng màn hình bạn đang làm việc."],
      ["document_scanner", "⌥⇧3", "Copy chữ (OCR)", "Kéo chọn chữ trong ảnh, video hay PDF, chữ gì cũng được: chữ hiện cạnh ảnh để xem lại, sửa rồi copy (⌘↩)."],
      ["radio_button_checked", "⌥⇧4", "Quay màn hình", "Kéo chọn vùng, chỉnh lại rồi bấm Bắt đầu; nhấp đúp để quay cả màn hình. Bấm lại ⌥⇧4 để dừng."],
    ],
    more: "Ngoài ra: ⌥⇧0 mở cài đặt. Tạm dừng / Tiếp tục quay, Vẽ lên ảnh vừa chụp, Copy ảnh vừa chụp và Mở thư mục lưu cũng có thể gán phím tắt riêng. Chuột phải vào icon trên thanh menu để tắt Longo Shot (nhả phím tắt) hoặc thoát; nhấp đúp để mở cài đặt.",
  },
});
---

<section id="capture" class="mx-auto w-full max-w-[1440px] px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="mx-auto mb-space-xl max-w-2xl text-center">
    <span class="inline-flex rounded-full bg-surface-container-high px-3 py-1 font-code text-label-badge uppercase tracking-wider text-primary">{t.badge}</span>
    <h2 class="mt-space-sm text-headline-xl tracking-tight">{t.title}</h2>
    <p class="mt-space-xs text-body-lg text-on-surface-variant">{t.lead}</p>
  </div>

  <div class="grid grid-cols-1 gap-gutter sm:grid-cols-2 lg:grid-cols-4">
    {t.cards.map(([icon, keys, title, body]) => (
      <div class="flex flex-col gap-space-xs rounded-2xl bg-surface-container-low p-space-lg shadow-xl">
        <div class="flex shrink-0 h-11 w-11 items-center justify-center rounded-xl bg-tertiary/15"><span class="material-symbols-outlined text-[24px] text-tertiary">{icon}</span></div>
        <span class="mt-space-xs font-display text-headline-sm text-on-surface">{keys}</span>
        <span class="font-code text-xs text-primary">{title}</span>
        <p class="text-body-md text-on-surface-variant">{body}</p>
      </div>
    ))}
  </div>

  <div class="mt-gutter rounded-xl bg-surface-container-lowest p-space-md">
    <span class="flex items-start gap-space-xs font-code text-xs text-on-surface-variant"><span class="material-symbols-outlined text-[18px] text-primary">keyboard_command_key</span>{t.more}</span>
  </div>
</section>
