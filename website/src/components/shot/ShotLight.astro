---
import { pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    badge: "Feature 05 · Light & private", title: "There When You Need It, Gone When You Don't",
    lead: "Longo Shot waits in the background for its shortcuts and stays out of the way the rest of the time.",
    cards: [
      ["speed", "~0%", "CPU while idle", "Nothing runs between captures. Closing the window releases what it was holding."],
      ["visibility_off", "⌥⇧0", "Hide the menu bar icon", "Shortcuts keep working. Press ⌥⇧0, or open the app again, to get back to Settings."],
      ["close", "Close", "Keeps running", "Closing the window doesn't quit: your shortcuts stay on until you choose Quit."],
      ["login", "Login", "Starts silently", "Start at Login opens it in the background, ready from the moment your Mac starts."],
    ],
    next: "Coming next", nextTitle: "Screen recording",
    nextBody: "Record the whole screen or a part of it, and stop with the same shortcut. It's the next part being built, coming in the next version.",
    permTitle: "Permissions, honestly",
    perms: [
      ["Screenshots and Copy Text", "Screen Recording"],
      ["Global shortcuts", "None"],
      ["Accessibility, Input Monitoring", "Not needed"],
    ],
    local: "Everything stays on your Mac: text is recognized on-device, no account, no network, no telemetry. Source available on GitHub.",
  },
  vi: {
    badge: "Chức năng 05 · Nhẹ & riêng tư", title: "Cần Thì Có, Không Cần Thì Im Lặng",
    lead: "Longo Shot chạy nền chờ phím tắt, còn lại thì không làm phiền bạn.",
    cards: [
      ["speed", "~0%", "CPU khi rảnh", "Giữa các lần chụp không có gì chạy. Đóng cửa sổ là giải phóng những gì nó đang giữ."],
      ["visibility_off", "⌥⇧0", "Ẩn icon trên thanh menu", "Phím tắt vẫn chạy. Bấm ⌥⇧0, hoặc mở lại app, để quay về cài đặt."],
      ["close", "Đóng", "Vẫn chạy nền", "Đóng cửa sổ không phải là thoát: phím tắt vẫn bật cho tới khi bạn chọn Thoát."],
      ["login", "Khởi động", "Mở âm thầm", "Mở cùng máy sẽ chạy app ở chế độ nền, sẵn sàng ngay từ lúc máy khởi động."],
    ],
    next: "Sắp có", nextTitle: "Quay màn hình",
    nextBody: "Quay cả màn hình hoặc một phần, bấm lại phím tắt để dừng. Đây là phần tiếp theo đang được làm, sẽ có trong bản kế tiếp.",
    permTitle: "Quyền cần cấp, nói thật",
    perms: [
      ["Chụp màn hình và Copy chữ", "Ghi màn hình"],
      ["Phím tắt toàn hệ thống", "Không cần"],
      ["Trợ năng, Theo dõi đầu vào", "Không cần"],
    ],
    local: "Mọi thứ ở trên máy bạn: chữ được nhận dạng ngay trên máy, không tài khoản, không mạng, không telemetry. Mã nguồn có trên GitHub.",
  },
});
---

<section id="light" class="mx-auto w-full max-w-[1440px] px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="mx-auto mb-space-xl max-w-2xl text-center">
    <span class="inline-flex rounded-full bg-surface-container-high px-3 py-1 font-code text-label-badge uppercase tracking-wider text-primary">{t.badge}</span>
    <h2 class="mt-space-sm text-headline-xl tracking-tight">{t.title}</h2>
    <p class="mt-space-xs text-body-lg text-on-surface-variant">{t.lead}</p>
  </div>

  <div class="grid grid-cols-1 gap-gutter sm:grid-cols-2 lg:grid-cols-4">
    {t.cards.map(([icon, value, title, body]) => (
      <div class="flex flex-col gap-space-xs rounded-2xl bg-surface-container-low p-space-lg shadow-xl">
        <div class="flex shrink-0 h-11 w-11 items-center justify-center rounded-xl bg-primary-container/15"><span class="material-symbols-outlined text-[24px] text-primary">{icon}</span></div>
        <span class="mt-space-xs font-display text-headline-sm text-on-surface">{value}</span>
        <span class="font-code text-xs text-primary">{title}</span>
        <p class="text-body-md text-on-surface-variant">{body}</p>
      </div>
    ))}
  </div>

  <div class="mt-gutter grid grid-cols-1 items-start gap-gutter lg:grid-cols-2">
    <div class="flex flex-col gap-space-xs rounded-2xl bg-surface-container-low p-space-lg shadow-xl">
      <span class="flex flex-wrap items-center gap-space-xs font-display text-headline-sm">
        <span class="material-symbols-outlined text-[22px] text-secondary">videocam</span>{t.nextTitle}
        <span class="rounded bg-secondary/15 px-2 py-0.5 font-code text-[11px] font-normal text-secondary">{t.next}</span>
      </span>
      <p class="text-body-md text-on-surface-variant">{t.nextBody}</p>
    </div>
    <div class="flex flex-col gap-space-sm rounded-2xl bg-surface-container-low p-space-lg shadow-xl">
      <span class="flex items-center gap-space-xs font-display text-headline-sm"><span class="material-symbols-outlined text-[22px] text-tertiary">lock</span>{t.permTitle}</span>
      <div class="flex flex-col divide-y divide-outline-variant/20">
        {t.perms.map(([what, need]) => (
          <div class="flex items-center justify-between gap-space-sm py-1.5 text-body-md">
            <span class="text-on-surface-variant">{what}</span>
            <span class="shrink-0 font-code text-xs text-tertiary">{need}</span>
          </div>
        ))}
      </div>
      <p class="font-code text-[11px] text-on-surface-variant">{t.local}</p>
    </div>
  </div>
</section>
