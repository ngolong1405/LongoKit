---
import { pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    badge: "Feature 05 · After a capture", title: "Saved, Copied, Ready to Paste",
    lead: "Every capture lands in two places at once: a file in your folder and a copy on the clipboard. Paste it into a chat, a document or Finder without opening anything.",
    points: [
      "Named by date and time, like macOS does it, in the folder you choose (Downloads to start): PNG for captures, MP4 for recordings.",
      "Retina-correct: saved at 144 dpi, so it opens at the size you saw, not twice as big.",
      "Turn off Save to the folder and captures only go to the clipboard: nothing piles up on disk.",
    ],
    save: "Save to the folder", saveOn: "On: saved as a file and copied", saveOff: "Off: clipboard only, nothing saved",
    folder: "~/Downloads", clipboard: "Clipboard", clipBody: "Image + file · pastes into chats, docs and Finder",
    nothing: "Nothing saved",
    after: "After a capture", always: "Always on while captures aren't saved",
    chips: [["copy", "Copy to the clipboard"], ["draw", "Draw on it"], ["preview", "Preview"], ["sounds", "Sounds"], ["history", "History"]],
    preview: "Preview", previewBody: "A thumbnail in the corner of the screen: drag it into another app, or use its buttons. Recordings show their length.",
    copy: "Copy", draw: "Draw", finder: "Show in Finder", drag: "Drag into another app",
    sound: "Sounds are macOS's own: the shutter on a screenshot, tones when a recording begins, pauses, resumes and ends, the countdown ticks, and a tink when text is copied. One switch, and never captured into a recording.",
  },
  vi: {
    badge: "Chức năng 05 · Sau khi chụp", title: "Đã Lưu, Đã Copy, Dán Được Ngay",
    lead: "Mỗi lần chụp có mặt ở hai nơi cùng lúc: một file trong thư mục của bạn và một bản trong clipboard. Dán thẳng vào khung chat, tài liệu hay Finder, không cần mở gì thêm.",
    points: [
      "Đặt tên theo ngày giờ như macOS vẫn làm, lưu trong thư mục bạn chọn (mặc định là Downloads): PNG cho ảnh chụp, MP4 cho video quay màn hình.",
      "Đúng chuẩn Retina: lưu ở 144 dpi, mở ra đúng kích thước bạn thấy chứ không to gấp đôi.",
      "Tắt Lưu vào thư mục thì ảnh chỉ nằm trong clipboard: không có file nào chất đống trên ổ đĩa.",
    ],
    save: "Lưu vào thư mục", saveOn: "Bật: lưu file và copy", saveOff: "Tắt: chỉ copy vào clipboard, không lưu file",
    folder: "~/Downloads", clipboard: "Clipboard", clipBody: "Ảnh + file · dán vào chat, tài liệu và Finder",
    nothing: "Không lưu file",
    after: "Sau khi chụp", always: "Luôn bật khi không lưu ảnh vào thư mục",
    chips: [["copy", "Copy vào clipboard"], ["draw", "Vẽ ngay"], ["preview", "Xem nhanh"], ["sounds", "Âm thanh"], ["history", "Lịch sử"]],
    preview: "Xem nhanh", previewBody: "Ảnh nhỏ ở góc màn hình: kéo thả sang app khác, hoặc dùng các nút trên đó. Video thì hiện cả độ dài.",
    copy: "Copy", draw: "Vẽ", finder: "Mở trong Finder", drag: "Kéo thả sang app khác",
    sound: "Âm thanh có sẵn của macOS: tiếng chụp khi chụp ảnh, tiếng khi bắt đầu, tạm dừng, tiếp tục và dừng quay, tiếng đếm ngược, và một tiếng “tink” khi copy chữ. Một nút bật tắt, và không bao giờ bị thu vào video.",
  },
});
---

<section id="output" class="mx-auto w-full max-w-[1440px] px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="grid grid-cols-1 items-center gap-gutter-lg lg:grid-cols-2">
    <div class="flex flex-col gap-gutter" id="shot-output">
      <div class="rounded-2xl bg-surface-container-low p-space-lg shadow-xl">
        <div class="mb-space-md flex items-center justify-between gap-space-sm rounded-xl bg-surface-container p-space-sm">
          <div class="flex flex-col">
            <span class="text-body-md font-medium">{t.save}</span>
            <span class="text-xs text-on-surface-variant" data-mode></span>
          </div>
          <label class="relative inline-flex shrink-0 cursor-pointer items-center">
            <input type="checkbox" checked class="peer sr-only" aria-label={t.save} data-save />
            <span class="h-6 w-11 rounded-full bg-surface-container-highest transition-colors peer-checked:bg-primary-container after:absolute after:top-[2px] after:left-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full"></span>
          </label>
        </div>
        <!-- The General tab's checkbox chips; Copy stays on while nothing is saved, as in the app. -->
        <span class="mb-space-xs block font-code text-[10px] uppercase tracking-wider text-on-surface-variant">{t.after}</span>
        <div class="mb-space-md flex flex-wrap gap-1.5">
          {t.chips.map(([id, name]) => (
            <button type="button" aria-pressed="true" data-chip={id} class="flex items-center gap-1.5 rounded-lg bg-surface-container px-2 py-1 text-xs text-on-surface-variant transition-colors"><span class="flex h-3.5 w-3.5 items-center justify-center rounded-[4px] border border-current text-[10px] leading-none" data-check>✓</span>{name}</button>
          ))}
        </div>
        <!-- Where the capture went, following the switch. -->
        <div class="flex flex-col gap-space-xs">
          <div class="flex items-center gap-space-sm rounded-lg px-2 py-2 transition-opacity" data-file>
            <span class="material-symbols-outlined text-[22px] text-tertiary">folder</span>
            <div class="flex min-w-0 flex-col">
              <span class="truncate font-code text-xs text-on-surface" data-name>Longo Shot 2026-11-11 at 09.41.07.png</span>
              <span class="font-code text-[11px] text-on-surface-variant">{t.folder} · 144 dpi</span>
            </div>
          </div>
          <div class="flex items-center gap-space-sm rounded-lg px-2 py-2">
            <span class="material-symbols-outlined text-[22px] text-primary">content_paste</span>
            <div class="flex min-w-0 flex-col">
              <span class="font-code text-xs text-on-surface">{t.clipboard}</span>
              <span class="font-code text-[11px] text-on-surface-variant">{t.clipBody}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- The preview thumbnail, as it sits in the corner of the screen after a capture. -->
      <div class="flex flex-col gap-space-md rounded-2xl bg-surface-container-low p-space-lg shadow-xl sm:flex-row sm:items-center">
        <div class="relative w-40 shrink-0 self-center overflow-hidden rounded-lg border-2 border-white shadow-xl">
          <div class="aspect-[16/10] bg-gradient-to-br from-[#ff8a50] via-[#8b5cf6] to-[#06b6d4]"></div>
          <div class="absolute inset-x-0 bottom-0 flex justify-center gap-1 bg-black/40 p-1 backdrop-blur-sm">
            <span class="rounded bg-white/90 px-1.5 font-code text-[9px] text-[#141b2b]">{t.copy}</span>
            <span class="rounded bg-white/90 px-1.5 font-code text-[9px] text-[#141b2b]">{t.draw}</span>
            <span class="rounded bg-white/90 px-1.5 font-code text-[9px] text-[#141b2b]">Finder</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <span class="flex items-center gap-space-xs font-display text-headline-sm"><span class="material-symbols-outlined text-[22px] text-secondary">photo</span>{t.preview}</span>
          <p class="text-body-md text-on-surface-variant">{t.previewBody}</p>
          <span class="font-code text-[11px] text-on-surface-variant">{t.drag} · {t.copy} · {t.draw} · {t.finder}</span>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-space-md">
      <span class="w-fit rounded-full bg-surface-container-high px-3 py-1 font-code text-label-badge uppercase tracking-wider text-primary">{t.badge}</span>
      <h2 class="text-headline-xl tracking-tight">{t.title}</h2>
      <p class="text-body-lg text-on-surface-variant">{t.lead}</p>
      <div class="flex flex-col gap-space-xs border-l-2 border-primary pl-space-md text-body-md text-on-surface-variant">
        {t.points.map((p) => <p>• {p}</p>)}
      </div>
      <p class="font-code text-[11px] text-on-surface-variant">{t.sound}</p>
    </div>
  </div>
</section>

<style>
  #shot-output [data-chip][aria-pressed="true"] { color: var(--c-on-surface); background: var(--c-surface-container-high); }
  #shot-output [data-chip][aria-pressed="false"] [data-check] { color: transparent; }
  #shot-output [data-chip]:disabled { opacity: 0.6; cursor: default; }
</style>

<script define:vars={{ t }}>
  const demo = document.getElementById("shot-output");
  const save = demo.querySelector("[data-save]"), file = demo.querySelector("[data-file]"), name = demo.querySelector("[data-name]");
  const copy = demo.querySelector('[data-chip="copy"]');
  const fileName = name.textContent;
  let copyOn = true;
  demo.querySelectorAll("[data-chip]").forEach((b) => b.addEventListener("click", () => {
    const on = b.getAttribute("aria-pressed") !== "true";
    b.setAttribute("aria-pressed", String(on));
    if (b === copy) copyOn = on;
  }));
  const show = () => {
    copy.disabled = !save.checked;
    copy.title = save.checked ? "" : t.always;
    copy.setAttribute("aria-pressed", String(!save.checked || copyOn));
    demo.querySelector("[data-mode]").textContent = save.checked ? t.saveOn : t.saveOff;
    file.classList.toggle("opacity-40", !save.checked);
    name.textContent = save.checked ? fileName : t.nothing;
  };
  save.addEventListener("change", show);
  show();
</script>
