---
import logoLight from "../../../brand/logo/logo-light.png";
import { repo, mouseDownload, mouseReleaseNotes, mouseVersion, coffeeURL } from "../data/site";
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    badge: "Free · Beta", title: "Ready to Level Up Your Mouse?", lead: "No ads, no account, no data collection.",
    macTitle: "LongoMouse for macOS", macBody: "A universal build for Apple Silicon and Intel, macOS 13 Ventura or later.",
    version: "Version", freeBeta: "Free during beta", download: "Download the installer (.dmg)",
    notarize: "This beta isn't notarized by Apple yet: the first time, right-click the app → Open.",
    winTitle: "LongoMouse for Windows", winBody: "Planned, with a Fluent interface for Windows 11.",
    status: "Status", soon: "Coming soon", follow: "Follow on GitHub",
    roadmap: [
      ["LongoKeys", "Key remapping, layers, and shortcuts for your keyboard."],
      ["LongoDisplay", "External display brightness and multi-display layouts."],
    ],
    coffeeTitle: "Like LongoMouse? Buy me a coffee", coffeeBody: "The app is free; every coffee buys more time for LongoKit.",
    history: "Release notes", source: "Build from source", issues: "Bugs & ideas",
  },
  vi: {
    badge: "Miễn phí · Beta", title: "Sẵn Sàng Nâng Tầm Trải Nghiệm Chuột Của Bạn?", lead: "Không quảng cáo, không tài khoản, không thu thập dữ liệu.",
    macTitle: "LongoMouse cho macOS", macBody: "Bản universal chạy trên chip Apple Silicon và Intel, macOS 13 Ventura trở lên.",
    version: "Phiên bản", freeBeta: "Miễn phí khi beta", download: "Tải bản cài đặt (.dmg)",
    notarize: "Bản beta chưa được Apple notarize: lần đầu mở, nhấn chuột phải vào app → Open.",
    winTitle: "LongoMouse cho Windows", winBody: "Đang được lên kế hoạch, với giao diện Fluent cho Windows 11.",
    status: "Trạng thái", soon: "Sắp có", follow: "Theo dõi trên GitHub",
    roadmap: [
      ["LongoKeys", "Đổi phím, lớp phím và phím tắt cho bàn phím."],
      ["LongoDisplay", "Độ sáng màn hình ngoài và bố cục nhiều màn hình."],
    ],
    coffeeTitle: "Thích LongoMouse? Mời mình một ly cà phê", coffeeBody: "App miễn phí; mỗi ly cà phê giúp mình có thêm thời gian làm LongoKit.",
    history: "Ghi chú phát hành", source: "Tự build từ mã nguồn", issues: "Báo lỗi & góp ý",
  },
});

const roadmap = [
  { icon: "keyboard", tint: "text-secondary", name: t.roadmap[0][0], body: t.roadmap[0][1] },
  { icon: "desktop_windows", tint: "text-tertiary", name: t.roadmap[1][0], body: t.roadmap[1][1] },
];
---

<section id="downloads" class="relative w-full px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="pointer-events-none absolute bottom-10 left-1/3 h-[300px] w-[600px] rounded-full bg-primary-container/10 blur-[160px]"></div>
  <div class="relative z-10 mx-auto flex max-w-[1440px] flex-col gap-space-2xl">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-space-xs text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-surface-container-high px-3 py-1 font-code text-label-badge text-primary uppercase">
        <img src={logoLight.src} alt="" class="h-4 w-4 rounded-sm object-cover" />
        {t.badge}
      </div>
      <h2 class="text-headline-lg">{t.title}</h2>
      <p class="text-body-lg text-on-surface-variant">{t.lead}</p>
    </div>

    <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-gutter-lg md:grid-cols-2">
      <div class="flex flex-col justify-between gap-space-lg rounded-2xl bg-surface-container p-space-xl shadow-xl">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-container-lowest shadow-md">
              <span class="material-symbols-outlined text-[36px]">laptop_mac</span>
            </div>
            <span class="rounded-full bg-primary-container/20 px-2.5 py-1 font-code text-label-badge text-primary">Apple Silicon &amp; Intel</span>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-headline-md">{t.macTitle}</h3>
            <p class="text-body-sm text-on-surface-variant">{t.macBody}</p>
          </div>
          <div class="flex flex-col gap-1.5 rounded-xl bg-surface-container-lowest p-3 font-code text-[11px] text-on-surface-variant">
            <div class="flex justify-between"><span>File: LongoMouse.dmg</span><span class="text-on-surface">~4 MB</span></div>
            <div class="flex justify-between"><span>{t.version}: {mouseVersion} beta</span><span class="text-tertiary">{t.freeBeta}</span></div>
          </div>
        </div>
        <div class="flex flex-col gap-space-xs">
          <a
            href={mouseDownload}
            class="flex items-center justify-center gap-space-xs rounded-xl bg-primary-container px-6 py-3.5 text-center font-semibold text-on-primary shadow-lg shadow-primary-container/25 transition-all hover:opacity-95"
          >
            <span class="material-symbols-outlined text-[20px]">download</span>
            {t.download}
          </a>
          <span class="text-center font-code text-[11px] text-on-surface-variant">
            {t.notarize}
          </span>
        </div>
      </div>

      <div class="flex flex-col justify-between gap-space-lg rounded-2xl bg-surface-container p-space-xl opacity-80 shadow-xl">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-container-lowest shadow-md">
              <span class="material-symbols-outlined text-[36px] text-secondary">desktop_windows</span>
            </div>
            <span class="rounded-full bg-secondary-container/30 px-2.5 py-1 font-code text-label-badge text-secondary">Windows 10 &amp; 11</span>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-headline-md">{t.winTitle}</h3>
            <p class="text-body-sm text-on-surface-variant">{t.winBody}</p>
          </div>
          <div class="flex flex-col gap-1.5 rounded-xl bg-surface-container-lowest p-3 font-code text-[11px] text-on-surface-variant">
            <div class="flex justify-between"><span>{t.status}</span><span class="text-secondary">{t.soon}</span></div>
          </div>
        </div>
        <a
          href={repo}
          class="flex items-center justify-center gap-space-xs rounded-xl bg-surface-container-high px-6 py-3.5 text-center font-semibold shadow-md transition-all hover:bg-surface-bright"
        >
          <span class="material-symbols-outlined text-[20px] text-secondary">notifications</span>
          {t.follow}
        </a>
      </div>
    </div>

    <div id="roadmap" class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-gutter md:grid-cols-2">
      {
        roadmap.map((r) => (
          <div class="flex items-start gap-space-sm rounded-xl bg-surface-container-low p-space-md">
            <span class:list={["material-symbols-outlined text-[24px]", r.tint]}>{r.icon}</span>
            <div class="flex flex-col">
              <span class="flex items-center gap-2 font-display font-semibold">
                {r.name}
                <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] font-normal text-on-surface-variant">{t.soon}</span>
              </span>
              <span class="text-body-sm text-on-surface-variant">{r.body}</span>
            </div>
          </div>
        ))
      }
    </div>

    {
      coffeeURL && (
        <a
          href={coffeeURL}
          class="mx-auto flex w-full max-w-4xl items-center justify-between gap-space-md rounded-2xl bg-gradient-to-r from-primary-container/15 to-secondary-container/20 p-space-lg transition-all hover:from-primary-container/25"
        >
          <span class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined text-[28px] text-primary">local_cafe</span>
            <span class="flex flex-col">
              <span class="font-display font-semibold">{t.coffeeTitle}</span>
              <span class="text-body-sm text-on-surface-variant">{t.coffeeBody}</span>
            </span>
          </span>
          <span class="material-symbols-outlined text-[20px] text-primary">arrow_forward</span>
        </a>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-space-lg pt-space-md font-code text-label-code text-on-surface-variant">
      <a class="flex items-center gap-1 transition-colors hover:text-primary" href={mouseReleaseNotes}>
        <span class="material-symbols-outlined text-[16px]">history</span> {t.history}
      </a>
      <span>•</span>
      <a class="flex items-center gap-1 transition-colors hover:text-primary" href={`${repo}/tree/main/apps/mouse-macos`}>
        <span class="material-symbols-outlined text-[16px]">code</span> {t.source}
      </a>
      <span>•</span>
      <a class="flex items-center gap-1 transition-colors hover:text-primary" href={`${repo}/issues`}>
        <span class="material-symbols-outlined text-[16px]">forum</span> {t.issues}
      </a>
    </div>
  </div>
</section>
