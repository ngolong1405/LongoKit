---
import logoLight from "../../../brand/logo/logo-light.png";
import { repo, mouseDownload, mouseVersion, coffeeURL, licenseURL } from "../data/site";

const roadmap = [
  { icon: "keyboard", tint: "text-secondary", name: "LongoKeys", body: "Đổi phím, lớp phím và phím tắt cho bàn phím." },
  { icon: "desktop_windows", tint: "text-tertiary", name: "LongoDisplay", body: "Độ sáng màn hình ngoài và bố cục nhiều màn hình." },
];
---

<section id="downloads" class="relative w-full px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="pointer-events-none absolute bottom-10 left-1/3 h-[300px] w-[600px] rounded-full bg-primary-container/10 blur-[160px]"></div>
  <div class="relative z-10 mx-auto flex max-w-[1440px] flex-col gap-space-2xl">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-space-xs text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-surface-container-high px-3 py-1 font-code text-label-badge text-primary uppercase">
        <img src={logoLight.src} alt="" class="h-4 w-4 rounded-sm object-cover" />
        Miễn phí · Beta
      </div>
      <h2 class="text-headline-lg">Sẵn Sàng Nâng Tầm Trải Nghiệm Chuột Của Bạn?</h2>
      <p class="text-body-lg text-on-surface-variant">Không quảng cáo, không tài khoản, không thu thập dữ liệu.</p>
    </div>

    <div class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-gutter-lg md:grid-cols-2">
      <div class="flex flex-col justify-between gap-space-lg rounded-2xl bg-surface-container p-space-xl shadow-xl">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-container-lowest shadow-md">
              <span class="material-symbols-outlined text-[36px]">laptop_mac</span>
            </div>
            <span class="rounded-full bg-primary-container/20 px-2.5 py-1 font-code text-label-badge text-primary">Apple Silicon &amp; Intel</span>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-headline-md">LongoMouse cho macOS</h3>
            <p class="text-body-sm text-on-surface-variant">Bản universal chạy trên chip Apple Silicon và Intel, macOS 13 Ventura trở lên.</p>
          </div>
          <div class="flex flex-col gap-1.5 rounded-xl bg-surface-container-lowest p-3 font-code text-[11px] text-on-surface-variant">
            <div class="flex justify-between"><span>File: LongoMouse.dmg</span><span class="text-on-surface">~4 MB</span></div>
            <div class="flex justify-between"><span>Phiên bản: {mouseVersion} beta</span><span class="text-tertiary">Miễn phí khi beta</span></div>
          </div>
        </div>
        <div class="flex flex-col gap-space-xs">
          <a
            href={mouseDownload}
            class="flex items-center justify-center gap-space-xs rounded-xl bg-primary-container px-6 py-3.5 text-center font-semibold text-on-primary shadow-lg shadow-primary-container/25 transition-all hover:opacity-95"
          >
            <span class="material-symbols-outlined text-[20px]">download</span>
            Tải bản cài đặt (.dmg)
          </a>
          <span class="text-center font-code text-[11px] text-on-surface-variant">
            Bản beta chưa được Apple notarize: lần đầu mở, nhấn chuột phải vào app → Open.
          </span>
        </div>
      </div>

      <div class="flex flex-col justify-between gap-space-lg rounded-2xl bg-surface-container p-space-xl opacity-80 shadow-xl">
        <div class="flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-container-lowest shadow-md">
              <span class="material-symbols-outlined text-[36px] text-secondary">desktop_windows</span>
            </div>
            <span class="rounded-full bg-secondary-container/30 px-2.5 py-1 font-code text-label-badge text-secondary">Windows 10 &amp; 11</span>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-headline-md">LongoMouse cho Windows</h3>
            <p class="text-body-sm text-on-surface-variant">Đang được lên kế hoạch, với giao diện Fluent cho Windows 11.</p>
          </div>
          <div class="flex flex-col gap-1.5 rounded-xl bg-surface-container-lowest p-3 font-code text-[11px] text-on-surface-variant">
            <div class="flex justify-between"><span>Trạng thái</span><span class="text-secondary">Sắp có</span></div>
          </div>
        </div>
        <a
          href={repo}
          class="flex items-center justify-center gap-space-xs rounded-xl bg-surface-container-high px-6 py-3.5 text-center font-semibold shadow-md transition-all hover:bg-surface-bright"
        >
          <span class="material-symbols-outlined text-[20px] text-secondary">notifications</span>
          Theo dõi trên GitHub
        </a>
      </div>
    </div>

    <div id="roadmap" class="mx-auto grid w-full max-w-4xl grid-cols-1 gap-gutter md:grid-cols-2">
      {
        roadmap.map((r) => (
          <div class="flex items-start gap-space-sm rounded-xl bg-surface-container-low p-space-md">
            <span class:list={["material-symbols-outlined text-[24px]", r.tint]}>{r.icon}</span>
            <div class="flex flex-col">
              <span class="flex items-center gap-2 font-display font-semibold">
                {r.name}
                <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] font-normal text-on-surface-variant">Sắp có</span>
              </span>
              <span class="text-body-sm text-on-surface-variant">{r.body}</span>
            </div>
          </div>
        ))
      }
    </div>

    {
      coffeeURL && (
        <a
          href={coffeeURL}
          class="mx-auto flex w-full max-w-4xl items-center justify-between gap-space-md rounded-2xl bg-gradient-to-r from-primary-container/15 to-secondary-container/20 p-space-lg transition-all hover:from-primary-container/25"
        >
          <span class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined text-[28px] text-primary">local_cafe</span>
            <span class="flex flex-col">
              <span class="font-display font-semibold">Thích LongoMouse? Mời mình một ly cà phê</span>
              <span class="text-body-sm text-on-surface-variant">App miễn phí; mỗi ly cà phê giúp mình có thêm thời gian làm LongoKit.</span>
            </span>
          </span>
          <span class="material-symbols-outlined text-[20px] text-primary">arrow_forward</span>
        </a>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-space-lg pt-space-md font-code text-label-code text-on-surface-variant">
      <a class="flex items-center gap-1 transition-colors hover:text-primary" href={`${repo}/commits/main`}>
        <span class="material-symbols-outlined text-[16px]">history</span> Lịch sử thay đổi
      </a>
      <span>•</span>
      <a class="flex items-center gap-1 transition-colors hover:text-primary" href={`${repo}/tree/main/apps/mouse-macos`}>
        <span class="material-symbols-outlined text-[16px]">code</span> Tự build từ mã nguồn
      </a>
      <span>•</span>
      <a class="flex items-center gap-1 transition-colors hover:text-primary" href={`${repo}/issues`}>
        <span class="material-symbols-outlined text-[16px]">forum</span> Báo lỗi &amp; góp ý
      </a>
    </div>
  </div>
</section>
