---
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    title: "Smooth Scrolling",
    lead: "Each wheel notch glides and eases to a stop, like a trackpad.",
    osDefault: "OS default", regular: "Regular mouse",
    regularBody: "Jumps a full step per notch and stops dead.",
    regularNote: "Jumps a full step per notch",
    smoothTitle: "Trackpad-grade smooth",
    smoothBody: "Fast at first, then eases to a stop.",
    smoothNote: "120 Hz glide with a natural ease-out",
    tune: "Tune glide & scroll speed", perMouse: "Per mouse", glide: "Glide time", speed: "Scroll speed", soon: "Coming soon",
    tryIt: "Scroll with your mouse over either side: both move together.",
    modifiers: "Hold ⌥ to scroll slowly, ⌘ to scroll fast.", slow: "⌥ held: precise, ¼ speed", fast: "⌘ held: turbo, 4× speed",
    micro: [
      ["Smooth notch by notch", "No more jumpy scrolling."],
      ["Mouse-only direction", "Natural or Classic, without touching the trackpad."],
      ["Speed & modifiers", "0.5× to 2×. Hold ⌥ for slow, ⌘ for fast."],
      ["Per-app speed", "Different speeds for different apps."],
    ],
  },
  vi: {
    title: "Cuộn Mượt Mà",
    lead: "Mỗi nấc bánh xe trượt mượt rồi chậm dần, như trackpad.",
    osDefault: "Mặc định của OS", regular: "Chuột thông thường",
    regularBody: "Nhảy cả đoạn mỗi nấc rồi dừng khựng.",
    regularNote: "Nhảy cả đoạn mỗi nấc",
    smoothTitle: "Chuẩn mượt Trackpad",
    smoothBody: "Nhanh lúc đầu, chậm dần đến khi dừng.",
    smoothNote: "Trượt 120 Hz, chậm dần tự nhiên",
    tune: "Tuỳ chỉnh độ trượt & tốc độ cuộn", perMouse: "Theo từng chuột", glide: "Thời gian trượt", speed: "Tốc độ cuộn", soon: "Sắp có",
    tryIt: "Lăn chuột trên một trong hai bên: cả hai cùng cuộn.",
    modifiers: "Giữ ⌥ để cuộn chậm, ⌘ để cuộn nhanh.", slow: "Đang giữ ⌥: cuộn chính xác, tốc độ ¼", fast: "Đang giữ ⌘: cuộn nhanh, tốc độ 4×",
    micro: [
      ["Cuộn mượt từng nấc", "Không còn giật cục khi cuộn."],
      ["Hướng cuộn riêng cho chuột", "Tự nhiên hoặc Cổ điển, trackpad giữ nguyên."],
      ["Tốc độ & phím bổ trợ", "Từ 0.5× đến 2×. Giữ ⌥ để chậm, ⌘ để nhanh."],
      ["Tốc độ theo từng app", "Mỗi app một tốc độ cuộn riêng."],
    ],
  },
});

const style = [
  { icon: "speed", tint: "text-primary", bg: "bg-primary-container/20" },
  { icon: "swap_vert", tint: "text-tertiary", bg: "bg-tertiary-container/30" },
  { icon: "keyboard_option_key", tint: "text-secondary", bg: "bg-secondary-container/30" },
  { icon: "apps", tint: "text-primary", bg: "bg-surface-bright", soon: true },
];
const micro = style.map((s, i) => ({ ...s, title: t.micro[i][0], body: t.micro[i][1] }));
---

<section class="w-full bg-surface-container-lowest/50 px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-space-2xl">
    <div class="flex max-w-2xl flex-col gap-space-xs">
      <div class="flex items-center gap-space-xs">
        <span class="h-2 w-2 rounded-full bg-primary-container"></span>
        <span class="font-code text-label-badge tracking-wider text-primary uppercase">Core Pillar 01</span>
      </div>
      <h2 class="text-headline-lg">{t.title}</h2>
      <p class="text-body-lg text-on-surface-variant">{t.lead}</p>
    </div>

    <div class="grid grid-cols-1 items-center gap-gutter-lg lg:grid-cols-12">
      <!-- Live comparison: the wheel over either pane scrolls both, one jumping and one gliding like the app. -->
      <div class="flex flex-col gap-space-md lg:col-span-7" id="scroll-demo">
        <div class="grid grid-cols-2 gap-gutter-sm">
          {[["jump", t.osDefault, t.regularBody, "text-error", "bg-surface-container-highest"], ["glide", "LongoMouse", t.smoothBody, "text-primary", "bg-primary-container/20"]].map(([id, tag, body, tint, chip]) => (
            <div class="flex flex-col gap-space-sm rounded-2xl bg-surface-container-low p-space-md shadow-md">
              <div class="flex items-center justify-between">
                <span class:list={["rounded px-2 py-0.5 font-code text-label-badge", chip, tint]}>{tag}</span>
                <span class:list={["material-symbols-outlined text-[20px]", tint]}>{id === "jump" ? "block" : "check_circle"}</span>
              </div>
              <p class="text-body-sm text-on-surface-variant">{body}</p>
              <div class="relative h-56 overflow-hidden rounded-lg bg-surface-container-lowest" data-pane={id}>
                <div class="absolute inset-x-0 top-0 flex flex-col gap-2 p-3 will-change-transform" data-content>
                  {Array.from({ length: 40 }, (_, i) => (
                    <div class="flex items-center gap-2 rounded-md bg-surface-container px-2 py-1.5">
                      <span class:list={["h-5 w-5 shrink-0 rounded", i % 3 === 0 ? "bg-primary-container/40" : i % 3 === 1 ? "bg-secondary-container/40" : "bg-tertiary/30"]}></span>
                      <span class="h-2 rounded-full bg-on-surface-variant/25" style={`width: ${40 + ((i * 37) % 50)}%`}></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="text-center font-code text-[11px] text-on-surface-variant">{t.tryIt}</p>

        <div class="flex flex-col gap-space-sm rounded-2xl bg-surface-container-high p-space-md shadow-md">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[20px] text-primary">tune</span>
              <span class="font-code text-body-sm font-semibold">{t.tune}</span>
            </div>
            <span class="rounded bg-surface-container px-2 py-0.5 font-code text-label-badge text-tertiary">{t.perMouse}</span>
          </div>
          <div class="grid grid-cols-1 gap-gutter-sm pt-2 md:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="flex justify-between font-code text-[11px] text-on-surface-variant">{t.glide}<span class="font-bold text-primary" data-smooth-value>800 ms</span></span>
              <input type="range" min="0" max="100" value="75" data-smooth class="h-1.5 w-full cursor-pointer accent-[#ff6b35]" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="flex justify-between font-code text-[11px] text-on-surface-variant">{t.speed}<span class="font-bold text-secondary" data-speed-value>1.00×</span></span>
              <input type="range" min="50" max="200" step="5" value="100" data-speed class="h-1.5 w-full cursor-pointer accent-[#8a4cfc]" />
            </label>
          </div>
          <span class="font-code text-[11px] text-on-surface-variant" data-mod>{t.modifiers}</span>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-space-md lg:col-span-5">
        {
          micro.map((m) => (
            <div class="flex items-start gap-space-sm rounded-xl bg-surface-container-low p-space-md shadow-sm">
              <div class:list={["flex h-10 w-10 shrink-0 items-center justify-center rounded-lg", m.bg]}>
                <span class:list={["material-symbols-outlined text-[22px]", m.tint]}>{m.icon}</span>
              </div>
              <div class="flex flex-col">
                <h4 class="flex items-center gap-2 text-[16px] font-semibold">
                  {m.title}
                  {m.soon && <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] font-normal text-on-surface-variant">{t.soon}</span>}
                </h4>
                <p class="mt-1 text-body-sm text-on-surface-variant">{m.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script define:vars={{ t }}>
  const demo = document.getElementById("scroll-demo");
  const panes = { jump: demo.querySelector('[data-pane="jump"]'), glide: demo.querySelector('[data-pane="glide"]') };
  const content = { jump: panes.jump.querySelector("[data-content]"), glide: panes.glide.querySelector("[data-content]") };
  const smooth = demo.querySelector("[data-smooth]"), speed = demo.querySelector("[data-speed]"), mod = demo.querySelector("[data-mod]");
  const pos = { jump: 0, glide: 0 };
  let target = 0, last = 0, running = false;
  const limit = () => Math.max(0, content.jump.scrollHeight - panes.jump.clientHeight);
  const show = (id) => { content[id].style.transform = `translateY(${-pos[id]}px)`; };

  // Like the app: each frame covers a share of what's left, so it starts fast and eases out;
  // the glide time (smoothness 0…1) sets how long it takes to settle, about 200…1000 ms.
  const frame = (now) => {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    const duration = 0.2 + 0.8 * (+smooth.value / 100);
    pos.glide += (target - pos.glide) * (1 - Math.exp(-dt / (duration / 4)));
    if (Math.abs(target - pos.glide) < 0.5) { pos.glide = target; running = false; }
    show("glide");
    if (running) requestAnimationFrame(frame);
  };

  const wheel = (e) => {
    e.preventDefault();
    let factor = +speed.value / 100;
    if (e.altKey) factor *= 0.25; else if (e.metaKey) factor *= 4;
    mod.textContent = e.altKey ? t.slow : e.metaKey ? t.fast : t.modifiers;
    // A notched wheel reports ±120 per notch (wheelDeltaY); a notch is about 40 px of page.
    // Trackpads and smooth wheels report pixels, which both sides follow as they are.
    const notches = e.wheelDeltaY && e.wheelDeltaY % 120 === 0 ? -e.wheelDeltaY / 120 : e.deltaMode === 1 ? e.deltaY : 0;
    const pixels = notches ? notches * 40 : e.deltaY;
    pos.jump = Math.min(Math.max(pos.jump + pixels * factor, 0), limit());
    show("jump");
    target = Math.min(Math.max(target + pixels * factor, 0), limit());
    if (!running) { running = true; last = performance.now(); requestAnimationFrame(frame); }
  };
  Object.values(panes).forEach((pane) => pane.addEventListener("wheel", wheel, { passive: false }));

  smooth.addEventListener("input", () => {
    demo.querySelector("[data-smooth-value]").textContent = Math.round((0.2 + 0.8 * (+smooth.value / 100)) * 1000) + " ms";
  });
  speed.addEventListener("input", () => {
    demo.querySelector("[data-speed-value]").textContent = (+speed.value / 100).toFixed(2) + "×";
  });
</script>
