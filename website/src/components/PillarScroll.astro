---
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    title: "Smooth Scrolling",
    lead: "No more stepped, jerky scrolling on an external mouse. LongoMouse glides each wheel notch like a trackpad and eases it to a stop (like Lenis on the web).",
    osDefault: "OS default", regular: "Regular mouse",
    regularBody: "Jumps a whole step per notch and stops dead — tiring when reading long documents or code.",
    regularNote: "Jumps a full step per notch",
    smoothTitle: "Trackpad-grade smooth",
    smoothBody: "Each notch is split into many small steps: fast at first, then easing to a stop.",
    smoothNote: "120 Hz glide with a natural ease-out",
    tune: "Tune glide & scroll speed", perMouse: "Per mouse", glide: "Glide time", speed: "Scroll speed", soon: "Coming soon",
    micro: [
      ["Smooth notch by notch", "Each wheel notch glides and slows down instead of jumping. Keep spinning and the notches blend into one motion."],
      ["Mouse-only scroll direction", "Pick Natural or Classic for the mouse while the trackpad keeps its macOS setting."],
      ["Speed & modifier keys", "Set scroll speed from 0.5× to 2×. Hold ⌥ for precise slow scrolling, ⌘ to fly through long documents."],
      ["Per-app speed", "Fast in VS Code, precise in Figma, untouched in games."],
    ],
  },
  vi: {
    title: "Cuộn Mượt Mà (Smooth Scrolling)",
    lead: "Xoá cảm giác giật cục từng khấc trên chuột ngoài. LongoMouse trượt mỗi nấc bánh xe như trackpad, theo kiểu chậm dần tự nhiên (giống Lenis trên web).",
    osDefault: "Mặc định của OS", regular: "Chuột thông thường",
    regularBody: "Giật cục từng nấc, trang nhảy cả đoạn rồi dừng khựng, mỏi mắt khi đọc văn bản hay code dài.",
    regularNote: "Nhảy cả đoạn mỗi nấc",
    smoothTitle: "Chuẩn mượt Trackpad",
    smoothBody: "Mỗi nấc được chia thành nhiều bước nhỏ, nhanh lúc đầu và chậm dần đến khi dừng.",
    smoothNote: "Trượt 120 Hz, chậm dần tự nhiên",
    tune: "Tuỳ chỉnh độ trượt & tốc độ cuộn", perMouse: "Theo từng chuột", glide: "Thời gian trượt", speed: "Tốc độ cuộn", soon: "Sắp có",
    micro: [
      ["Cuộn mượt từng nấc", "Mỗi nấc bánh xe được trượt mượt rồi chậm dần thay vì nhảy cục. Lăn liên tục thì các nấc nối thành một chuyển động liền."],
      ["Hướng cuộn riêng cho chuột", "Chọn Tự nhiên hoặc Cổ điển cho chuột, trong khi trackpad vẫn giữ cài đặt của macOS."],
      ["Tốc độ & phím bổ trợ", "Chỉnh tốc độ cuộn từ 0.5× đến 2×. Giữ ⌥ để cuộn chậm chính xác, ⌘ để lướt nhanh tài liệu dài."],
      ["Tốc độ theo từng app", "Cuộn nhanh trong VS Code, chính xác trong Figma, giữ mặc định khi chơi game."],
    ],
  },
});

const style = [
  { icon: "speed", tint: "text-primary", bg: "bg-primary-container/20" },
  { icon: "swap_vert", tint: "text-tertiary", bg: "bg-tertiary-container/30" },
  { icon: "keyboard_option_key", tint: "text-secondary", bg: "bg-secondary-container/30" },
  { icon: "apps", tint: "text-primary", bg: "bg-surface-bright", soon: true },
];
const micro = style.map((s, i) => ({ ...s, title: t.micro[i][0], body: t.micro[i][1] }));
---

<section class="w-full bg-surface-container-lowest/50 px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-space-2xl">
    <div class="flex max-w-2xl flex-col gap-space-xs">
      <div class="flex items-center gap-space-xs">
        <span class="h-2 w-2 rounded-full bg-primary-container"></span>
        <span class="font-code text-label-badge tracking-wider text-primary uppercase">Core Pillar 01</span>
      </div>
      <h2 class="text-headline-lg">{t.title}</h2>
      <p class="text-body-lg text-on-surface-variant">{t.lead}</p>
    </div>

    <div class="grid grid-cols-1 items-center gap-gutter-lg lg:grid-cols-12">
      <div class="flex flex-col gap-space-md lg:col-span-7">
        <div class="grid grid-cols-1 gap-gutter md:grid-cols-2">
          <div class="flex flex-col gap-space-sm rounded-2xl bg-surface-container-low p-space-lg shadow-md">
            <div class="flex items-center justify-between">
              <span class="rounded bg-surface-container-highest px-2 py-0.5 font-code text-label-badge text-error">{t.osDefault}</span>
              <span class="material-symbols-outlined text-[20px] text-error">block</span>
            </div>
            <h3 class="text-headline-sm">{t.regular}</h3>
            <p class="text-body-sm text-on-surface-variant">{t.regularBody}</p>
            <div class="flex h-24 flex-col justify-end rounded-lg bg-surface-container-lowest p-2">
              <svg class="h-16 w-full text-error/60" fill="none" viewBox="0 0 200 40" aria-hidden="true">
                <path d="M 0 35 L 20 35 L 20 15 L 40 15 L 40 35 L 70 35 L 70 5 L 90 5 L 90 35 L 120 35 L 120 10 L 140 10 L 140 35 L 200 35" stroke="currentColor" stroke-width="2"></path>
              </svg>
              <span class="mt-1 text-center font-code text-[10px] text-on-surface-variant">{t.regularNote}</span>
            </div>
          </div>
          <div class="flex flex-col gap-space-sm rounded-2xl bg-surface-container p-space-lg shadow-xl">
            <div class="flex items-center justify-between">
              <span class="rounded bg-primary-container/20 px-2 py-0.5 font-code text-label-badge text-primary">LongoMouse</span>
              <span class="material-symbols-outlined text-[20px] text-primary">check_circle</span>
            </div>
            <h3 class="text-headline-sm">{t.smoothTitle}</h3>
            <p class="text-body-sm text-on-surface-variant">{t.smoothBody}</p>
            <div class="flex h-24 flex-col justify-end rounded-lg bg-surface-container-lowest p-2">
              <svg class="h-16 w-full text-primary-container" fill="none" viewBox="0 0 200 40" aria-hidden="true">
                <path d="M 0 35 C 30 35, 40 5, 80 5 C 130 5, 160 30, 200 35" stroke="currentColor" stroke-width="2.5"></path>
                <path d="M 0 35 C 30 35, 40 5, 80 5 C 130 5, 160 30, 200 35 L 200 40 L 0 40 Z" fill="currentColor" fill-opacity="0.15"></path>
              </svg>
              <span class="mt-1 text-center font-code text-[10px] text-primary">{t.smoothNote}</span>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-space-sm rounded-2xl bg-surface-container-high p-space-md shadow-md">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[20px] text-primary">tune</span>
              <span class="font-code text-body-sm font-semibold">{t.tune}</span>
            </div>
            <span class="rounded bg-surface-container px-2 py-0.5 font-code text-label-badge text-tertiary">{t.perMouse}</span>
          </div>
          <div class="grid grid-cols-1 gap-gutter-sm pt-2 md:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between font-code text-[11px] text-on-surface-variant">
                <span>{t.glide}</span><span class="font-bold text-primary">800 ms</span>
              </div>
              <div class="h-2 w-full overflow-hidden rounded-full bg-surface-container-lowest">
                <div class="h-full w-[75%] rounded-full bg-gradient-to-r from-primary-container to-primary"></div>
              </div>
            </div>
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between font-code text-[11px] text-on-surface-variant">
                <span>{t.speed}</span><span class="font-bold text-secondary">1.25×</span>
              </div>
              <div class="h-2 w-full overflow-hidden rounded-full bg-surface-container-lowest">
                <div class="h-full w-[50%] rounded-full bg-gradient-to-r from-secondary-container to-secondary"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-space-md lg:col-span-5">
        {
          micro.map((m) => (
            <div class="flex items-start gap-space-sm rounded-xl bg-surface-container-low p-space-md shadow-sm">
              <div class:list={["flex h-10 w-10 shrink-0 items-center justify-center rounded-lg", m.bg]}>
                <span class:list={["material-symbols-outlined text-[22px]", m.tint]}>{m.icon}</span>
              </div>
              <div class="flex flex-col">
                <h4 class="flex items-center gap-2 text-[16px] font-semibold">
                  {m.title}
                  {m.soon && <span class="rounded bg-surface-container-high px-1.5 font-code text-[10px] font-normal text-on-surface-variant">{t.soon}</span>}
                </h4>
                <p class="mt-1 text-body-sm text-on-surface-variant">{m.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
