---
import Logo from "./Logo.astro";
import { repo, mouseVersion, displayVersion, keysVersion, shotVersion, kitVersion, coffeeURL, licenseURL } from "../data/site";
import { localize, pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const t = pick(lang, {
  en: {
    blurb: "Small, fast tools for mice, keyboards, displays and screenshots on macOS and Windows.",
    products: "Products", mouseNote: "Buttons, gestures & smooth scrolling", soon: "Coming soon", kitNote: "All four, in one app",
    displayNote: "Brightness & volume for every display", keysNote: "Key remapping & the Hyper layer", shotNote: "Screenshots, recording & copying text on screen",
    compat: "Compatibility", compatList: ["macOS 13 Ventura or later (Longo Shot: macOS 14+)", "Apple Silicon & Intel", "Windows: coming soon"],
    community: "Community", source: "Source on GitHub", issues: "Report a bug or idea", history: "Changelog",
    coffee: "Buy me a coffee ☕", license: "Source-available · LongoKit License",
  },
  vi: {
    blurb: "Bộ công cụ nhỏ, nhanh cho chuột, bàn phím, màn hình và chụp màn hình trên macOS và Windows.",
    products: "Sản phẩm", mouseNote: "Nút, cử chỉ & cuộn mượt", soon: "Sắp có", kitNote: "Cả bốn, trong một app",
    displayNote: "Độ sáng & âm lượng cho mọi màn hình", keysNote: "Đổi phím & lớp phím Hyper", shotNote: "Chụp, quay màn hình & copy chữ trên màn hình",
    compat: "Tương thích", compatList: ["macOS 13 Ventura trở lên (Longo Shot: macOS 14+)", "Apple Silicon & Intel", "Windows: sắp có"],
    community: "Cộng đồng", source: "Mã nguồn trên GitHub", issues: "Báo lỗi & góp ý", history: "Lịch sử thay đổi",
    coffee: "Mời một ly cà phê ☕", license: "Source-available · Giấy phép LongoKit",
  },
});
---

<footer class="mt-space-3xl w-full bg-surface-container-lowest">
  <div class="mx-auto max-w-[1440px] px-margin-mobile pt-space-2xl pb-space-xl md:px-margin-desktop">
    <div class="grid grid-cols-1 gap-gutter-lg pb-space-2xl md:grid-cols-2 lg:grid-cols-5">
      <div class="flex flex-col gap-space-md lg:col-span-2">
        <div class="flex items-center gap-space-sm">
          <Logo class="h-8 w-8 rounded-lg object-contain shadow-sm" />
          <span class="font-display text-headline-sm">LongoKit</span>
        </div>
        <p class="max-w-sm text-body-sm text-on-surface-variant">{t.blurb}</p>
        <div class="flex items-center gap-space-xs">
          <span class="h-2 w-2 animate-pulse rounded-full bg-tertiary"></span>
          <span class="font-code text-label-code text-tertiary">LongoKit v{kitVersion} · LongoMouse v{mouseVersion} · LongoDisplay v{displayVersion}{keysVersion && ` · LongoKeys v${keysVersion}`} · LongoShot v{shotVersion} beta</span>
        </div>
      </div>
      <div class="flex flex-col gap-space-sm">
        <h4 class="text-[15px] font-semibold">{t.products}</h4>
        <ul class="flex flex-col gap-space-xs text-body-sm">
          <li class="flex flex-col"><a class="font-medium text-secondary hover:underline" href={localize(lang, "/kit")}>LongoKit</a><span class="font-code text-[11px] text-on-surface-variant">{t.kitNote}</span></li>
          <li class="flex flex-col"><a class="font-medium text-primary hover:underline" href={localize(lang, "/mouse")}>LongoMouse</a><span class="font-code text-[11px] text-on-surface-variant">{t.mouseNote}</span></li>
          <li class="flex flex-col"><a class="hover:text-secondary" href={localize(lang, "/keys")}>LongoKeys</a><span class="font-code text-[11px] text-on-surface-variant">{keysVersion ? t.keysNote : t.soon}</span></li>
          <li class="flex flex-col"><a class="hover:text-tertiary" href={localize(lang, "/display")}>LongoDisplay</a><span class="font-code text-[11px] text-on-surface-variant">{t.displayNote}</span></li>
          <li class="flex flex-col"><a class="hover:text-tertiary" href={localize(lang, "/shot")}>LongoShot</a><span class="font-code text-[11px] text-on-surface-variant">{t.shotNote}</span></li>
        </ul>
      </div>
      <div class="flex flex-col gap-space-sm">
        <h4 class="text-[15px] font-semibold">{t.compat}</h4>
        <ul class="flex flex-col gap-space-xs text-body-sm text-on-surface-variant">
          {t.compatList.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="flex flex-col gap-space-sm">
        <h4 class="text-[15px] font-semibold">{t.community}</h4>
        <ul class="flex flex-col gap-space-xs text-body-sm text-on-surface-variant">
          <li><a class="hover:text-primary" href={repo}>{t.source}</a></li>
          <li><a class="hover:text-primary" href={`${repo}/issues`}>{t.issues}</a></li>
          <li><a class="hover:text-primary" href={`${repo}/commits/main`}>{t.history}</a></li>
          {coffeeURL && <li><a class="hover:text-primary" href={coffeeURL}>{t.coffee}</a></li>}
        </ul>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-space-md pt-space-lg font-code text-label-code text-on-surface-variant md:flex-row">
      <span>© {year} LongoKit · Crafted by <span class="text-primary">Long Ngô</span></span>
      <span class="flex items-center gap-space-md">
        <a class="flex items-center gap-1 hover:text-primary" href={repo}>
          <span class="material-symbols-outlined text-[16px]">code</span>GitHub
        </a>
        <a class="hover:text-primary" href={licenseURL}>{t.license}</a>
      </span>
    </div>
  </div>
</footer>
