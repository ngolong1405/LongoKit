---
import Logo from "./Logo.astro";
import { counterpart, localize, pick, type Lang } from "../i18n";
import { keysVersion } from "../data/site";

interface Props {
  lang: Lang;
  /** Which product page is open, to highlight it in the nav. */
  active?: "mouse" | "display" | "keys" | "shot";
}

const { lang, active } = Astro.props;
const other = counterpart(Astro.url.pathname);
const t = pick(lang, {
  en: { soon: "soon", theme: "Switch light / dark", language: "Tiếng Việt", download: "Download Free", short: "Get" },
  vi: { soon: "sắp có", theme: "Đổi giao diện sáng / tối", language: "English", download: "Tải miễn phí", short: "Tải" },
});

const products = [
  { id: "mouse", href: localize(lang, "/mouse"), icon: "mouse", tint: "text-primary", name: "LongoMouse", soon: false },
  { id: "keys", href: localize(lang, "/keys"), icon: "keyboard", tint: "text-secondary", name: "LongoKeys", soon: !keysVersion },
  { id: "display", href: localize(lang, "/display"), icon: "desktop_windows", tint: "text-tertiary", name: "LongoDisplay", soon: false },
  { id: "shot", href: localize(lang, "/shot"), icon: "screenshot_region", tint: "text-primary-container", name: "LongoShot", soon: false },
];
---

<header class="fixed inset-x-0 top-0 z-50 bg-surface/75 shadow-[0_1px_16px_var(--c-shadow)] backdrop-blur-2xl">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between gap-gutter px-margin-mobile md:px-margin-desktop">
    <a class="group flex items-center gap-space-sm" href={localize(lang, "/")}>
      <Logo class="h-9 w-9 rounded-xl object-contain shadow-md" />
      <span class="font-display text-headline-sm tracking-tight transition-colors group-hover:text-primary">LongoKit</span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-surface-container-low/60 p-1.5 backdrop-blur-md lg:flex">
      {
        products.map((p) => (
          <a
            href={p.href}
            class:list={[
              "flex items-center gap-1.5 rounded-full px-4 py-1.5 text-body-sm transition-all",
              active === p.id
                ? "bg-surface-container-high font-semibold text-primary"
                : "text-on-surface-variant hover:bg-surface-container hover:text-on-surface",
            ]}
          >
            <span class:list={["material-symbols-outlined text-[16px]", p.tint]}>{p.icon}</span>
            <!-- Four apps don't fit at lg with the full names: "Longo" shows from xl up. -->
            <span><span class="hidden xl:inline">Longo</span>{p.name.replace("Longo", "")}</span>
            {p.soon && <span class="rounded bg-surface-container-high px-1 font-code text-[9px] uppercase text-on-surface-variant">{t.soon}</span>}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-space-sm">
      <a
        id="lang-switch"
        href={other.href}
        data-lang={other.lang}
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-surface-container-low font-code text-[11px] font-semibold text-on-surface-variant shadow-sm transition-all hover:bg-surface-container hover:text-primary"
        title={t.language}
        aria-label={t.language}
        hreflang={other.lang}
      >
        {other.lang.toUpperCase()}
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-surface-container-low shadow-sm transition-all hover:bg-surface-container"
        title={t.theme}
        aria-label={t.theme}
      >
        <!-- Wrapped: the icon font's own display rule would override `hidden` on the icon itself. -->
        <span class="dark:hidden"><span class="material-symbols-outlined text-[18px] text-primary">dark_mode</span></span>
        <span class="hidden dark:inline"><span class="material-symbols-outlined text-[18px] text-primary">light_mode</span></span>
      </button>
      <a
        href={active === "display" || active === "keys" || active === "shot" ? "#downloads" : localize(lang, "/#downloads")}
        class="flex items-center gap-space-xs whitespace-nowrap rounded-xl bg-gradient-to-r from-primary-container to-secondary-container px-4 py-2 text-body-sm font-semibold text-white shadow-[0_4px_20px_rgba(255,107,53,0.3)] transition-all hover:opacity-95"
      >
        <span class="material-symbols-outlined text-[18px]">download</span>
        <span class="hidden sm:inline">{t.download}</span>
        <span class="sm:hidden">{t.short}</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
  const langSwitch = document.getElementById("lang-switch");
  langSwitch?.addEventListener("click", () => {
    try { localStorage.setItem("lang", langSwitch.dataset.lang ?? "en"); } catch {}
    langSwitch.setAttribute("href", langSwitch.getAttribute("href") + location.hash);
  });
</script>
