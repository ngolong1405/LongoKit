---
import logo from "../../../brand/logo/logo-dark.png";
import { repo, mouseVersion } from "../data/site";

const products = [
  { href: "#mouse", icon: "mouse", tint: "text-primary", name: "LongoMouse", soon: false },
  { href: "#roadmap", icon: "keyboard", tint: "text-secondary", name: "LongoKeys", soon: true },
  { href: "#roadmap", icon: "desktop_windows", tint: "text-tertiary", name: "LongoDisplay", soon: true },
];
---

<header class="fixed inset-x-0 top-0 z-50 bg-surface/75 shadow-[0_1px_16px_rgba(0,0,0,0.35)] backdrop-blur-2xl">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between gap-gutter px-margin-mobile md:px-margin-desktop">
    <a class="group flex items-center gap-space-sm" href="#top">
      <img src={logo.src} alt="LongoKit" class="h-9 w-9 rounded-xl object-contain shadow-md" />
      <div class="flex flex-col">
        <div class="flex items-center gap-space-xs">
          <span class="font-display text-headline-sm tracking-tight transition-colors group-hover:text-primary">LongoKit</span>
          <span class="rounded bg-surface-container-high px-1.5 py-0.5 font-code text-label-badge uppercase text-tertiary">v{mouseVersion} beta</span>
        </div>
        <span class="flex items-center gap-1 font-code text-[11px] text-on-surface-variant opacity-80">
          <span class="material-symbols-outlined text-[13px] text-primary-container">mouse</span>
          <span class="material-symbols-outlined text-[13px] text-tertiary">desktop_windows</span>
          <span class="material-symbols-outlined text-[13px] text-secondary">keyboard</span>
        </span>
      </div>
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-surface-container-low/60 p-1.5 backdrop-blur-md lg:flex">
      {
        products.map((p) => (
          <a
            href={p.href}
            class="flex items-center gap-1.5 rounded-full px-4 py-1.5 text-body-sm text-on-surface-variant transition-all hover:bg-surface-container hover:text-on-surface"
          >
            <span class:list={["material-symbols-outlined text-[16px]", p.tint]}>{p.icon}</span>
            <span>{p.name}</span>
            {p.soon && <span class="rounded bg-surface-container-high px-1 font-code text-[9px] uppercase text-on-surface-variant">soon</span>}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-space-sm">
      <a
        href={repo}
        class="hidden items-center gap-space-xs rounded-xl bg-surface-container-low px-3.5 py-2 font-code text-label-code transition-all hover:bg-surface-container sm:flex"
      >
        <span class="material-symbols-outlined text-[16px] text-primary-container">code</span>
        <span>GitHub</span>
      </a>
      <a
        href="#downloads"
        class="flex items-center gap-space-xs rounded-xl bg-gradient-to-r from-primary-container to-secondary-container px-4 py-2 text-body-sm font-semibold shadow-[0_4px_20px_rgba(255,107,53,0.3)] transition-all hover:opacity-95"
      >
        <span class="material-symbols-outlined text-[18px]">download</span>
        <span class="hidden sm:inline">Download Free Beta</span>
        <span class="sm:hidden">Tải</span>
      </a>
    </div>
  </div>
</header>
