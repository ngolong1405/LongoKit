---
import logo from "../../../brand/logo/logo-dark.png";
import { repo } from "../data/site";

interface Props {
  /** Which product page is open, to highlight it in the nav. */
  active?: "mouse";
}

const { active } = Astro.props;

const products = [
  { id: "mouse", href: "/mouse", icon: "mouse", tint: "text-primary", name: "LongoMouse", soon: false },
  { id: "keys", href: "/#pillars", icon: "keyboard", tint: "text-secondary", name: "LongoKeys", soon: true },
  { id: "display", href: "/#pillars", icon: "desktop_windows", tint: "text-tertiary", name: "LongoDisplay", soon: true },
];
---

<header class="fixed inset-x-0 top-0 z-50 bg-surface/75 shadow-[0_1px_16px_var(--c-shadow)] backdrop-blur-2xl">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between gap-gutter px-margin-mobile md:px-margin-desktop">
    <a class="group flex items-center gap-space-sm" href="/">
      <img src={logo.src} alt="" class="h-9 w-9 rounded-xl object-contain shadow-md" />
      <span class="font-display text-headline-sm tracking-tight transition-colors group-hover:text-primary">LongoKit</span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-surface-container-low/60 p-1.5 backdrop-blur-md lg:flex">
      {
        products.map((p) => (
          <a
            href={p.href}
            class:list={[
              "flex items-center gap-1.5 rounded-full px-4 py-1.5 text-body-sm transition-all",
              active === p.id
                ? "bg-surface-container-high font-semibold text-primary"
                : "text-on-surface-variant hover:bg-surface-container hover:text-on-surface",
            ]}
          >
            <span class:list={["material-symbols-outlined text-[16px]", p.tint]}>{p.icon}</span>
            {p.name}
            {p.soon && <span class="rounded bg-surface-container-high px-1 font-code text-[9px] uppercase text-on-surface-variant">soon</span>}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-space-sm">
      <a
        href={repo}
        class="hidden items-center gap-space-xs rounded-xl bg-surface-container-low px-3.5 py-2 font-code text-label-code shadow-sm transition-all hover:bg-surface-container sm:flex"
      >
        <span class="material-symbols-outlined text-[16px] text-primary-container">code</span>
        GitHub
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-surface-container-low shadow-sm transition-all hover:bg-surface-container"
        title="Đổi giao diện sáng / tối"
        aria-label="Đổi giao diện sáng / tối"
      >
        <!-- Wrapped: the icon font's own display rule would override `hidden` on the icon itself. -->
        <span class="dark:hidden"><span class="material-symbols-outlined text-[18px] text-primary">dark_mode</span></span>
        <span class="hidden dark:inline"><span class="material-symbols-outlined text-[18px] text-primary">light_mode</span></span>
      </button>
      <a
        href="/#downloads"
        class="flex items-center gap-space-xs rounded-xl bg-gradient-to-r from-primary-container to-secondary-container px-4 py-2 text-body-sm font-semibold text-white shadow-[0_4px_20px_rgba(255,107,53,0.3)] transition-all hover:opacity-95"
      >
        <span class="material-symbols-outlined text-[18px]">download</span>
        <span class="hidden sm:inline">Download Free</span>
        <span class="sm:hidden">Tải</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
</script>
