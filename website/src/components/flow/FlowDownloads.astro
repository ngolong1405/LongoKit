---
import ProductIcon from "../ProductIcon.astro";
import { flowDownload, flowReleaseNotes, flowVersion } from "../../data/site";
import { pick, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(lang, {
  en: {
    badge: "Free · Beta", title: "Get Longo Flow",
    lead: "Install it on each Mac. No ads, no account, no data collection: everything stays on your network.",
    macTitle: "macOS", macBody: "Apple Silicon & Intel · macOS 13 or later",
    download: "Download the installer (.dmg)", notes: "Release notes",
    steps: "On both Macs: allow Accessibility (System Settings › Privacy & Security › Accessibility) and Local Network. Then on one, Macs › Nearby › Pair, and type the code the other shows.",
    notarize: "This beta isn't notarized yet. If macOS blocks it: System Settings › Privacy & Security › Open Anyway.",
    winTitle: "Windows", winBody: "Mac and Windows together is next.", soon: "Coming soon",
  },
  vi: {
    badge: "Miễn phí · Beta", title: "Tải Longo Flow",
    lead: "Cài trên từng máy Mac. Không quảng cáo, không tài khoản, không thu thập dữ liệu: mọi thứ chỉ trong mạng của bạn.",
    macTitle: "macOS", macBody: "Apple Silicon & Intel · macOS 13 trở lên",
    download: "Tải bản cài đặt (.dmg)", notes: "Ghi chú phát hành",
    steps: "Trên cả hai máy: cấp quyền Trợ năng (Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Trợ năng) và Mạng cục bộ. Rồi trên một máy, vào Máy Mac › Ở gần › Ghép đôi, nhập mã máy kia hiện.",
    notarize: "Bản beta chưa notarize. Nếu macOS chặn: Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Vẫn mở.",
    winTitle: "Windows", winBody: "Mac với Windows là bước tiếp theo.", soon: "Sắp có",
  },
});
---

<section id="downloads" class="mx-auto w-full max-w-[1440px] px-margin-mobile py-space-3xl md:px-margin-desktop">
  <div class="mx-auto mb-space-xl max-w-2xl text-center">
    <span class="inline-flex items-center gap-space-xs rounded-full bg-surface-container-high px-3 py-1 font-code text-label-badge uppercase tracking-wider text-primary">
      <span class="material-symbols-outlined text-[16px]">download</span>{t.badge} · v{flowVersion}
    </span>
    <h2 class="mt-space-sm text-headline-xl tracking-tight">{t.title}</h2>
    <p class="mt-space-xs text-body-lg text-on-surface-variant">{t.lead}</p>
  </div>
  <div class="mx-auto grid max-w-4xl grid-cols-1 gap-gutter md:grid-cols-2">
    <div class="flex flex-col gap-space-md rounded-2xl border-2 border-primary/40 bg-surface-container-low p-space-lg shadow-xl">
      <div class="flex items-center gap-space-sm">
        <ProductIcon product="flow" class="h-12 w-12" />
        <div>
          <h3 class="text-headline-sm">{t.macTitle}</h3>
          <span class="font-code text-xs text-primary">{t.macBody}</span>
        </div>
      </div>
      <a href={flowDownload} class="flex items-center justify-center gap-space-xs rounded-xl bg-gradient-to-r from-primary-container to-secondary-container py-3 font-display text-sm font-semibold text-white shadow-md transition-all hover:opacity-95">
        <span class="material-symbols-outlined text-[18px]">download</span>{t.download}
      </a>
      <a href={flowReleaseNotes} class="text-center font-code text-xs text-on-surface-variant hover:text-primary">{t.notes} · v{flowVersion}</a>
      <p class="font-code text-[11px] text-on-surface-variant">{t.steps}</p>
      <p class="font-code text-[11px] text-on-surface-variant">{t.notarize}</p>
    </div>
    <div class="flex flex-col gap-space-md rounded-2xl bg-surface-container-low p-space-lg opacity-80 shadow-xl">
      <div class="flex items-center gap-space-sm">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-tertiary/15"><span class="material-symbols-outlined text-[28px] text-tertiary">desktop_windows</span></div>
        <div>
          <h3 class="text-headline-sm">{t.winTitle}</h3>
          <span class="font-code text-xs text-tertiary">{t.soon}</span>
        </div>
      </div>
      <p class="text-body-md text-on-surface-variant">{t.winBody}</p>
    </div>
  </div>
</section>
