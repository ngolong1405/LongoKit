---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import ShotHero from "../components/shot/ShotHero.astro";
import ShotModes from "../components/shot/ShotModes.astro";
import ShotText from "../components/shot/ShotText.astro";
import ShotOutput from "../components/shot/ShotOutput.astro";
import ShotShortcuts from "../components/shot/ShotShortcuts.astro";
import ShotLight from "../components/shot/ShotLight.astro";
import ShotDownloads from "../components/shot/ShotDownloads.astro";
import Footer from "../components/Footer.astro";
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = pick(lang, {
  en: {
    title: "LongoShot · LongoKit",
    description: "LongoShot: screenshots of an area, a window or the whole screen, and on-screen text copied with on-device OCR, from shortcuts you choose on macOS.",
  },
  vi: {
    title: "LongoShot · LongoKit",
    description: "LongoShot: chụp một vùng, một cửa sổ hoặc cả màn hình, và chép chữ trên màn hình bằng OCR ngay trên máy, từ phím tắt bạn tự chọn trên macOS.",
  },
});
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Header lang={lang} active="shot" />
  <main class="relative w-full overflow-x-hidden pt-20">
    <ShotHero lang={lang} />
    <ShotModes lang={lang} />
    <ShotText lang={lang} />
    <ShotOutput lang={lang} />
    <ShotShortcuts lang={lang} />
    <ShotLight lang={lang} />
    <ShotDownloads lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
