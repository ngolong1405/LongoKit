---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import SuiteHero from "../components/suite/SuiteHero.astro";
import SuitePillars from "../components/suite/SuitePillars.astro";
import KitWhy from "../components/kit/KitWhy.astro";
import NativeStacks from "../components/suite/NativeStacks.astro";
import SuiteDownloads from "../components/suite/SuiteDownloads.astro";
import Footer from "../components/Footer.astro";
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = pick(lang, {
  en: {
    title: "LongoKit · Mouse, Displays, Keys, Screenshots & Sharing in one Mac app",
    description: "LongoKit: one native macOS menu bar app for your mouse, displays, keyboard, screenshots and sharing files, with Windows planned. Turn on the modules you need, at about a quarter of the memory; each is also its own app: LongoMouse, LongoDisplay, LongoKeys, LongoShot and LongoShare.",
  },
  vi: {
    title: "LongoKit · Chuột, màn hình, bàn phím & chụp màn hình trong một app Mac",
    description: "LongoKit: một app native trên thanh menu macOS cho chuột, màn hình, bàn phím, chụp màn hình và gửi file, Windows đang lên kế hoạch. Bật module bạn cần, chỉ tốn khoảng một phần tư RAM; mỗi module cũng là một app riêng: LongoMouse, LongoDisplay, LongoKeys, LongoShot và LongoShare.",
  },
});
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Header lang={lang} />
  <main class="relative w-full overflow-x-hidden pt-20">
    <SuiteHero lang={lang} />
    <SuitePillars lang={lang} />
    <KitWhy lang={lang} />
    <NativeStacks lang={lang} />
    <SuiteDownloads lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
