---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import SuiteHero from "../components/suite/SuiteHero.astro";
import SuitePillars from "../components/suite/SuitePillars.astro";
import NativeStacks from "../components/suite/NativeStacks.astro";
import SuiteDownloads from "../components/suite/SuiteDownloads.astro";
import Footer from "../components/Footer.astro";
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = pick(lang, {
  en: {
    title: "LongoKit · Mouse, Keys, Display & Screenshot tools",
    description: "LongoKit: small native tools for your mouse, keyboard, displays and screenshots on macOS, with Windows planned. LongoMouse, LongoKeys, LongoDisplay and LongoShot are out for macOS, each on its own or all four in one app, LongoKit.",
  },
  vi: {
    title: "LongoKit · Công cụ cho chuột, bàn phím, màn hình & chụp màn hình",
    description: "LongoKit: bộ công cụ native nhỏ gọn cho chuột, bàn phím, màn hình và chụp màn hình trên macOS, Windows đang lên kế hoạch. LongoMouse, LongoKeys, LongoDisplay và LongoShot đã có cho macOS, dùng riêng từng app hoặc cả bốn trong một app, LongoKit.",
  },
});
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Header lang={lang} />
  <main class="relative w-full overflow-x-hidden pt-20">
    <SuiteHero lang={lang} />
    <SuitePillars lang={lang} />
    <NativeStacks lang={lang} />
    <SuiteDownloads lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
