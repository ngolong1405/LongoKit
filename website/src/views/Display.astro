---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import DisplayHero from "../components/display/DisplayHero.astro";
import DisplayKeys from "../components/display/DisplayKeys.astro";
import DisplaySync from "../components/display/DisplaySync.astro";
import DisplayVolumePower from "../components/display/DisplayVolumePower.astro";
import DisplayConnections from "../components/display/DisplayConnections.astro";
import DisplayDownloads from "../components/display/DisplayDownloads.astro";
import Footer from "../components/Footer.astro";
import { pick, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = pick(lang, {
  en: {
    title: "LongoDisplay · LongoKit",
    description: "LongoDisplay: hardware brightness and speaker volume for external monitors over DDC/CI, Sync with your MacBook, and a safe way to turn displays off on macOS.",
  },
  vi: {
    title: "LongoDisplay · LongoKit",
    description: "LongoDisplay: chỉnh độ sáng phần cứng và âm lượng loa màn hình ngoài qua DDC/CI, đồng bộ theo MacBook, và tắt màn hình an toàn trên macOS.",
  },
});
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Header lang={lang} active="display" />
  <main class="relative w-full overflow-x-hidden pt-20">
    <DisplayHero lang={lang} />
    <DisplayKeys lang={lang} />
    <DisplaySync lang={lang} />
    <DisplayVolumePower lang={lang} />
    <DisplayConnections lang={lang} />
    <DisplayDownloads lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
